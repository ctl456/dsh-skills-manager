{
  "name": "@ctl456/dsh-skills-manager",
  "version": "0.1.0",
  "description": "Unofficial DeepSeek Harness plugin: add, edit, remove, enable and disable agent skills from the Web settings page or from chat, so the harness loads them with its own skill tool",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "agent-skills"
  ],
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctl456/dsh-skills-manager.git"
  },
  "homepage": "https://github.com/ctl456/dsh-skills-manager#readme",
  "bugs": {
    "url": "https://github.com/ctl456/dsh-skills-manager/issues"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "sync": "bash scripts/sync-from-harness.sh",
    "rename": "node scripts/set-package-name.mjs",
    "verify:install": "bash scripts/verify-install.sh",
    "release:check": "node scripts/verify-release.mjs",
    "prepublishOnly": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-util-values": "^0.1.5-rc.2"
  }
}
