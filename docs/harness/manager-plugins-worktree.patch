index 0000000000..3f6bcc6649
--- /dev/null
+++ b/packages/mcp/mcp-manager/tests/client-bundle.client.spec.ts
@@ -0,0 +1,125 @@
+// @vitest-environment jsdom
+
+/**
+ * Real tsdown artifact shape: lib/client.js hands off through
+ * window.__ModuleLoader__.load with the manifest id, resolves its externals
+ * through the injected require, returns apply + inject, and a mounted apply
+ * registers the MCP servers page into a real SlotRegistry ring as its own
+ * settings section. Skips when the bundle is not built
+ * (`pnpm --filter @deepseek-ai/dsh-mcp-manager bundle`).
+ */
+
+import { readFileSync } from 'node:fs'
+import { resolve } from 'node:path'
+import { Context, type Fiber } from '@deepseek-ai/cordis'
+import { afterEach, describe, expect, it } from 'vitest'
+import { LocaleRuntime } from '@deepseek-ai/dsh-client-locale/client'
+import { SlotRegistry } from '@deepseek-ai/dsh-client-ui-renderer/client'
+import type { SettingsScope } from '@deepseek-ai/dsh-client-ui-settings/client'
+import { resolveSlotLabel } from '@deepseek-ai/dsh-client-ui-slots'
+import type { McpManagerSettings } from '../src/client/card-controller.ts'
+
+const PLUGIN_ID = '@deepseek-ai/dsh-mcp-manager'
+
+/** The locale namespace the card's copy lives under. */
+const NS = 'settings.mcp-manager'
+
+interface Handoff { id: string; factory: (require: (spec: string) => unknown) => Record<string, unknown> }
+type Win = { __ModuleLoader__?: { load(h: Handoff): void } }
+
+function readBundle(): string | undefined {
+  try {
+    // import.meta.url is http-scheme in the jsdom pool; vitest runs from the
+    // repo root, so resolve the artifact repo-relatively instead.
+    return readFileSync(resolve('packages/mcp/mcp-manager/lib/client.js'), 'utf8')
+  } catch {
+    return undefined
+  }
+}
+
+/** A minimal bound scope: the card only projects the snapshot it carries. */
+function stubScope(value: McpManagerSettings = { servers: [] }): SettingsScope<McpManagerSettings> {
+  return {
+    getSnapshot: () => ({
+      status: 'ready',
+      value,
+      base: undefined,
+      user: undefined,
+      revision: 1,
+      writable: true,
+      mode: 'host',
+    }),
+    subscribe: () => () => {},
+    mutate: () => Promise.resolve(),
+    set: () => Promise.resolve(),
+    unset: () => Promise.resolve(),
+  }
+}
+
+afterEach(() => {
+  delete (window as Win).__ModuleLoader__
+})
+
+describe('tsdown client artifact', () => {
+  const code = readBundle()
+
+  async function loadArtifact() {
+    let handoff: Handoff | undefined
+    ;(window as Win).__ModuleLoader__ = { load: (h) => { handoff = h } }
+    // The implied-eval ban targets accidental string execution, not this
+    // deliberate built-bundle fixture running in the window scope.
+    // oxlint-disable-next-line typescript/no-implied-eval, typescript/no-unsafe-call
+    new Function(code!)()
+    expect(handoff).toBeDefined()
+    const modules = new Map<string, unknown>([
+      ['react/jsx-runtime', await import('react/jsx-runtime')],
+      ['@deepseek-ai/dsh-client-store', await import('@deepseek-ai/dsh-client-store')],
+      ['@deepseek-ai/dsh-client-ui-primitives', await import('@deepseek-ai/dsh-client-ui-primitives')],
+    ])
+    const exports = handoff!.factory((spec) => {
+      if (!modules.has(spec)) throw new Error(`unexpected require: ${spec}`)
+      return modules.get(spec)
+    })
+    return { handoff: handoff!, exports }
+  }
+
+  it.skipIf(code === undefined)('hands off with the manifest id and a DI-require factory', async () => {
+    const { handoff, exports } = await loadArtifact()
+    expect(handoff.id).toBe(PLUGIN_ID)
+    expect(exports.apply).toBeTypeOf('function')
+    expect(exports.inject).toEqual(['slots', 'locale', 'remote', 'settingsScope'])
+  })
+
+  it.skipIf(code === undefined)('mounted apply registers the page as a settings section', async () => {
+    const { exports } = await loadArtifact()
+    const api = exports as { apply: (ctx: Context) => void; inject: string[] }
+    const ctx = new Context()
+    await ctx.plugin(SlotRegistry).await()
+    const locale = new LocaleRuntime(ctx)
+    locale.setLocale('zh')
+    ctx.provide('locale', locale)
+    ctx.provide('remote', {} as never)
+    ctx.provide('settingsScope', { bind: () => stubScope() } as never)
+    const slots = ctx.get('slots') as SlotRegistry
+    // The page registers into settings.section, whose runtime declaration
+    // normally arrives with the settings shell; declare it here so the
+    // injection fires.
+    slots.register({
+      name: 'root',
+      children: { 'settings.section': { kind: 'list', scope: 'root' } },
+    } as never, () => null)
+
+    const fiber: Fiber = ctx.plugin({ inject: [...api.inject], apply: api.apply })
+    await fiber.await()
+
+    const entries = slots.entries('settings.section')
+    expect(entries).toHaveLength(1)
+    expect(entries[0]!.options.id).toBe('mcp-manager')
+    expect(entries[0]!.options.order).toBe(25)
+    expect(entries[0]!.locale).toBe(NS)
+    expect(resolveSlotLabel(entries[0]!.options.label)).toBe('MCP 服务器')
+
+    await fiber.dispose()
+    expect(slots.entries('settings.section')).toHaveLength(0)
+  })
+})
diff --git a/packages/mcp/mcp-manager/tests/index.client.spec.ts b/packages/mcp/mcp-manager/tests/index.client.spec.ts
new file mode 100644
index 0000000000..cd0de488cc
--- /dev/null
+++ b/packages/mcp/mcp-manager/tests/index.client.spec.ts
@@ -0,0 +1,136 @@
+/**
+ * Browser half registration tests: what `apply` contributes, and that it all
+ * leaves with the fiber. A real SlotRegistry and LocaleRuntime stand in for the
+ * shell; the settings transport is a stub scope, since this half never reads
+ * the wire itself.
+ */
+
+import { Context, type Fiber } from '@deepseek-ai/cordis'
+import { describe, expect, it } from 'vitest'
+import { LocaleRuntime } from '@deepseek-ai/dsh-client-locale/client'
+import { SlotRegistry } from '@deepseek-ai/dsh-client-ui-renderer/client'
+import type { SettingsScope } from '@deepseek-ai/dsh-client-ui-settings/client'
+import { resolveSlotLabel } from '@deepseek-ai/dsh-client-ui-slots'
+import { apply, inject, MCP_MANAGER_NS } from '../src/client/index.ts'
+import type { McpManagerSettings } from '../src/client/card-controller.ts'
+
+/** The locale namespace the card's copy lives under. */
+const NS = 'settings.mcp-manager'
+
+/** One `bind` call the plugin placed on the settings transport. */
+interface BindCall {
+  readonly namespace: string
+}
+
+/** A minimal bound scope: the card only projects the snapshot it carries. */
+function stubScope(value: McpManagerSettings = { servers: [] }): SettingsScope<McpManagerSettings> {
+  return {
+    getSnapshot: () => ({
+      status: 'ready',
+      value,
+      base: undefined,
+      user: undefined,
+      revision: 1,
+      writable: true,
+      mode: 'host',
+    }),
+    subscribe: () => () => {},
+    mutate: () => Promise.resolve(),
+    set: () => Promise.resolve(),
+    unset: () => Promise.resolve(),
+  }
+}
+
+interface Bench {
+  readonly ctx: Context
+  readonly slots: SlotRegistry
+  readonly locale: LocaleRuntime
+  readonly fiber: Fiber
+  readonly binds: BindCall[]
+}
+
+/** Load the browser half over a real slot registry and locale service. */
+async function bench(): Promise<Bench> {
+  const ctx = new Context()
+  await ctx.plugin(SlotRegistry).await()
+  const locale = new LocaleRuntime(ctx)
+  locale.setLocale('zh')
+  ctx.provide('locale', locale)
+  ctx.provide('remote', {} as never)
+  const binds: BindCall[] = []
+  ctx.provide('settingsScope', {
+    bind: (spec: BindCall) => {
+      binds.push(spec)
+      return stubScope()
+    },
+  } as never)
+  const slots = ctx.get('slots') as SlotRegistry
+  // The page registers into settings.section, whose runtime declaration
+  // normally arrives with the settings shell (ui-settings-general's root
+  // entry); declare it here so the injection fires.
+  slots.register({
+    name: 'root',
+    children: { 'settings.section': { kind: 'list', scope: 'root' } },
+  } as never, () => null)
+  const fiber = ctx.plugin({ inject: [...inject], apply })
+  await fiber.await()
+  return { ctx, slots, locale, fiber, binds }
+}
+
+describe('mcp-manager client apply', () => {
+  it('declares the services it uses', () => {
+    expect(inject).toEqual(['slots', 'locale', 'remote', 'settingsScope'])
+  })
+
+  it('keys the page on the settings namespace the Host serves', () => {
+    expect(MCP_MANAGER_NS).toBe('mcp-manager')
+  })
+
+  it('registers the card dictionary under the card namespace', async () => {
+    const { locale } = await bench()
+
+    expect(locale.bind(NS)('title')).toBe('MCP 服务器')
+    expect(locale.bind(NS)('remove')).toBe('删除')
+  })
+
+  it('binds the namespace scope and registers one section ided on it', async () => {
+    const { slots, binds } = await bench()
+
+    expect(binds).toEqual([{ namespace: 'mcp-manager' }])
+    const entries = slots.entries('settings.section')
+    expect(entries).toHaveLength(1)
+    expect(entries[0]!.options.id).toBe('mcp-manager')
+    // Below Agent presets (20) and any later section that claims a higher seat.
+    expect(entries[0]!.options.order).toBe(25)
+    expect(entries[0]!.locale).toBe(NS)
+    expect(resolveSlotLabel(entries[0]!.options.label)).toBe('MCP 服务器')
+  })
+
+  it('injects the card controller face, seeded from the bound scope', async () => {
+    const { slots } = await bench()
+
+    const entry = slots.entries('settings.section')[0]!
+    const face = (entry.inject as unknown as () => { hooks: { mcpManagerCard: { getSnapshot(): unknown } } })()
+    expect(face.hooks.mcpManagerCard.getSnapshot()).toMatchObject({
+      available: true,
+      writable: true,
+      servers: [],
+      query: '',
+      page: 0,
+      pageCount: 1,
+      visible: [],
+      addOpen: false,
+    })
+  })
+
+  it('collapses the dictionary and the section registration on teardown', async () => {
+    const { slots, locale, fiber } = await bench()
+    expect(slots.entries('settings.section')).toHaveLength(1)
+
+    await fiber.dispose()
+
+    expect(slots.entries('settings.section')).toHaveLength(0)
+    // Unregistered copy falls back to the key rather than a stale translation.
+    expect(locale.bind(NS)('title')).toBe('title')
+  })
+})
