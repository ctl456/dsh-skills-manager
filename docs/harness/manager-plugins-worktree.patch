+/** Tests for the pure MCP server registry: validation, projection, and the reconcile plan. */
+
+import { describe, expect, it } from 'vitest'
+import {
+  DEFAULT_TOOL_CALL_TIMEOUT_MS,
+  describeTarget,
+  mountSignature,
+  planReconcile,
+  toClientConfig,
+  toolPrefix,
+  validateServerEntry,
+  type McpServerEntry,
+} from '../src/servers.ts'
+
+/** Build a valid stdio entry, applying overrides. */
+function stdio(overrides: Partial<McpServerEntry> = {}): McpServerEntry {
+  return {
+    name: 'github',
+    transport: 'stdio',
+    enabled: true,
+    command: 'npx',
+    args: ['-y', '@modelcontextprotocol/server-github'],
+    env: {},
+    cwd: '',
+    url: '',
+    headers: {},
+    toolCallTimeoutMs: DEFAULT_TOOL_CALL_TIMEOUT_MS,
+    ...overrides,
+  }
+}
+
+/** Build a valid streamable-http entry, applying overrides. */
+function http(overrides: Partial<McpServerEntry> = {}): McpServerEntry {
+  return {
+    name: 'web',
+    transport: 'streamable-http',
+    enabled: true,
+    command: '',
+    args: [],
+    env: {},
+    cwd: '',
+    url: 'https://example.test/mcp',
+    headers: {},
+    toolCallTimeoutMs: DEFAULT_TOOL_CALL_TIMEOUT_MS,
+    ...overrides,
+  }
+}
+
+describe('validateServerEntry', () => {
+  it('accepts a stdio entry with a command', () => {
+    expect(validateServerEntry(stdio())).toEqual([])
+  })
+
+  it('rejects a stdio entry without a command', () => {
+    expect(validateServerEntry(stdio({ command: '   ' }))).toEqual(['a stdio server requires a command'])
+  })
+
+  it('rejects a namespace outside the pattern', () => {
+    expect(validateServerEntry(stdio({ name: 'bad name!' }))[0]).toContain('name must match')
+  })
+
+  it('accepts an http(s) endpoint', () => {
+    expect(validateServerEntry(http())).toEqual([])
+  })
+
+  it('rejects a missing or non-http endpoint', () => {
+    expect(validateServerEntry(http({ url: '' }))).toEqual(['a streamable-http server requires a url'])
+    expect(validateServerEntry(http({ url: 'ftp://example.test' }))).toEqual(['url must be an absolute http(s) URL'])
+    expect(validateServerEntry(http({ url: 'not a url' }))).toEqual(['url must be an absolute http(s) URL'])
+  })
+})
+
+describe('toClientConfig', () => {
+  it('projects a stdio entry with a resilient startup policy', () => {
+    expect(toClientConfig(stdio({ env: { TOKEN: 'x' }, cwd: '/work' }))).toEqual({
+      transport: 'stdio',
+      serverName: 'github',
+      command: 'npx',
+      args: ['-y', '@modelcontextprotocol/server-github'],
+      env: { TOKEN: 'x' },
+      cwd: '/work',
+      toolCallTimeoutMs: DEFAULT_TOOL_CALL_TIMEOUT_MS,
+      failOnStartupError: false,
+    })
+  })
+
+  it('projects a streamable-http entry', () => {
+    expect(toClientConfig(http({ headers: { Authorization: 'Bearer x' } }))).toEqual({
+      transport: 'streamable-http',
+      serverName: 'web',
+      url: 'https://example.test/mcp',
+      headers: { Authorization: 'Bearer x' },
+      toolCallTimeoutMs: DEFAULT_TOOL_CALL_TIMEOUT_MS,
+      failOnStartupError: false,
+    })
+  })
+
+  it('copies args, env, and headers so later mutation cannot reach the child config', () => {
+    const entry = stdio({ args: ['a'], env: { K: 'v' } })
+    const config = toClientConfig(entry)
+    entry.args.push('b')
+    expect(config.transport === 'stdio' && config.args).toEqual(['a'])
+  })
+})
+
+describe('mountSignature', () => {
+  it('is stable for equal entries and changes with the connection', () => {
+    expect(mountSignature(stdio())).toBe(mountSignature(stdio()))
+    expect(mountSignature(stdio())).not.toBe(mountSignature(stdio({ command: 'uvx' })))
+    expect(mountSignature(stdio({ enabled: false }))).toBe(mountSignature(stdio()))
+  })
+})
+
+describe('planReconcile', () => {
+  it('starts enabled valid entries and skips disabled or invalid ones', () => {
+    const plan = planReconcile(
+      [stdio(), stdio({ name: 'off', enabled: false }), stdio({ name: 'broken', command: '' })],
+      new Map(),
+    )
+    expect(plan.stop).toEqual([])
+    expect(plan.start.map(entry => entry.name)).toEqual(['github'])
+  })
+
+  it('keeps an unchanged live client', () => {
+    const plan = planReconcile([stdio()], new Map([['github', mountSignature(stdio())]]))
+    expect(plan).toEqual({ stop: [], start: [] })
+  })
+
+  it('stops a removed client', () => {
+    const plan = planReconcile([], new Map([['github', mountSignature(stdio())]]))
+    expect(plan.stop).toEqual(['github'])
+    expect(plan.start).toEqual([])
+  })
+
+  it('stops and restarts a changed client', () => {
+    const plan = planReconcile([stdio({ command: 'uvx' })], new Map([['github', mountSignature(stdio())]]))
+    expect(plan.stop).toEqual(['github'])
+    expect(plan.start.map(entry => entry.command)).toEqual(['uvx'])
+  })
+
+  it('keeps the last definition for a duplicated name', () => {
+    const plan = planReconcile([stdio({ command: 'first' }), stdio({ command: 'second' })], new Map())
+    expect(plan.start).toHaveLength(1)
+    expect(plan.start[0]?.command).toBe('second')
+  })
+})
+
+describe('toolPrefix and describeTarget', () => {
+  it('builds the stable public prefix', () => {
+    expect(toolPrefix('github')).toBe('mcp__github__')
+  })
+
+  it('describes a command line or endpoint', () => {
+    expect(describeTarget(stdio())).toBe('npx -y @modelcontextprotocol/server-github')
+    expect(describeTarget(stdio({ args: [] }))).toBe('npx')
+    expect(describeTarget(http())).toBe('https://example.test/mcp')
+  })
+})
diff --git a/packages/mcp/mcp-manager/tests/styles.client.spec.ts b/packages/mcp/mcp-manager/tests/styles.client.spec.ts
new file mode 100644
index 0000000000..b425e1b1ed
--- /dev/null
+++ b/packages/mcp/mcp-manager/tests/styles.client.spec.ts
@@ -0,0 +1,61 @@
+/**
+ * MCP manager card stylesheet contract, asserted against the CSS text on disk.
+ *
+ * A `--dsw-*` name the theme does not declare fails silently: the browser takes
+ * the `var()` fallback, so the card still renders and only one control is
+ * wrong. `--dsw-alias-bg-brand` and `--dsw-alias-text-on-brand` were never
+ * declared, so the primary action resolved to `currentColor` white text on a
+ * white label. Checking every name against the sheets that declare them turns
+ * that failure into a test failure.
+ */
+import { readdirSync, readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { describe, expect, it } from 'vitest'
+
+const css = readFileSync(
+  fileURLToPath(new URL('../src/client/McpManagerCard.module.css', import.meta.url)),
+  'utf8',
+)
+// Every theme sheet, not just the platform tokens: sibling sheets declare the
+// font and scrollbar variables, and a gate reading one file would call those
+// names undeclared.
+const tokens = readdirSync(fileURLToPath(new URL('../../../client/ui-theme/src/styles/', import.meta.url)))
+  .filter(name => name.endsWith('.css'))
+  .map(name => readFileSync(
+    fileURLToPath(new URL(`../../../client/ui-theme/src/styles/${name}`, import.meta.url)),
+    'utf8',
+  ))
+  .join('\n')
+
+/** The declarations of one top-level rule, by selector. */
+function block(selector: string): string {
+  const match = new RegExp(`^\\${selector} \\{([^}]*)\\}`, 'm').exec(css)
+  if (match === null) throw new Error(`McpManagerCard.module.css has no \`${selector}\` rule`)
+  return match[1] ?? ''
+}
+
+describe('McpManagerCard theme styles', () => {
+  it('names only theme variables the token sheet defines', () => {
+    const named = [...css.matchAll(/var\((--(?:dsw|dsh|ds)-[a-z0-9-]+)/g)].map(match => match[1])
+    const undeclared = [...new Set(named)].filter(name => !tokens.includes(`  ${String(name)}:`))
+    expect(undeclared).toEqual([])
+  })
+
+  it('closes every block, so no rule is swallowed by the one above it', () => {
+    const bare = css.replace(/\/\*[\s\S]*?\*\//g, '')
+    expect((bare.match(/\}/g) ?? []).length).toBe((bare.match(/\{/g) ?? []).length)
+  })
+
+  it('paints the primary action with the shared button pair', () => {
+    // The card owns its own class names, so nothing else fails when its
+    // primary action is invisible; the pair is the contract.
+    expect(block('.primary')).toContain('background: var(--dsw-alias-button-primary-fill)')
+    expect(block('.primary')).toContain('color: var(--dsw-alias-label-primary-foreground)')
+  })
+
+  it('never falls back to a literal colour', () => {
+    // A declared token never takes its fallback, so a literal here is a single
+    // colour for both themes and hides the next undeclared name.
+    expect(css).not.toMatch(/var\(--dsw-[a-z0-9-]+\s*,\s*(?:#|rgb|rgba|hsl|hsla)/)
+  })
+})
