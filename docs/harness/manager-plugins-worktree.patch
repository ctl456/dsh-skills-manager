@@ -0,0 +1,138 @@
+/**
+ * Browser half registration tests: what `apply` contributes, and that it all
+ * leaves with the fiber. A real SlotRegistry and LocaleRuntime stand in for the
+ * shell; the settings transport is a stub scope, since this half never reads
+ * the wire itself.
+ */
+
+import { Context, type Fiber } from '@deepseek-ai/cordis'
+import { describe, expect, it } from 'vitest'
+import { LocaleRuntime } from '@deepseek-ai/dsh-client-locale/client'
+import { SlotRegistry } from '@deepseek-ai/dsh-client-ui-renderer/client'
+import type { SettingsScope } from '@deepseek-ai/dsh-client-ui-settings/client'
+import { resolveSlotLabel } from '@deepseek-ai/dsh-client-ui-slots'
+import { apply, inject, SKILLS_MANAGER_NS } from '../src/client/index.ts'
+import type { SkillsManagerSettings } from '../src/client/card-controller.ts'
+
+/** The locale namespace the card's copy lives under. */
+const NS = 'settings.skills-manager'
+
+/** One `bind` call the plugin placed on the settings transport. */
+interface BindCall {
+  readonly namespace: string
+}
+
+/** A minimal bound scope: the card only projects the snapshot it carries. */
+function stubScope(value: SkillsManagerSettings = { skills: [] }): SettingsScope<SkillsManagerSettings> {
+  return {
+    getSnapshot: () => ({
+      status: 'ready',
+      value,
+      base: undefined,
+      user: undefined,
+      revision: 1,
+      writable: true,
+      mode: 'host',
+    }),
+    subscribe: () => () => {},
+    mutate: () => Promise.resolve(),
+    set: () => Promise.resolve(),
+    unset: () => Promise.resolve(),
+  }
+}
+
+interface Bench {
+  readonly ctx: Context
+  readonly slots: SlotRegistry
+  readonly locale: LocaleRuntime
+  readonly fiber: Fiber
+  readonly binds: BindCall[]
+}
+
+/** Load the browser half over a real slot registry and locale service. */
+async function bench(): Promise<Bench> {
+  const ctx = new Context()
+  await ctx.plugin(SlotRegistry).await()
+  const locale = new LocaleRuntime(ctx)
+  locale.setLocale('zh')
+  ctx.provide('locale', locale)
+  ctx.provide('remote', {} as never)
+  const binds: BindCall[] = []
+  ctx.provide('settingsScope', {
+    bind: (spec: BindCall) => {
+      binds.push(spec)
+      return stubScope()
+    },
+  } as never)
+  const slots = ctx.get('slots') as SlotRegistry
+  // The page registers into settings.section, whose runtime declaration
+  // normally arrives with the settings shell (ui-settings-general's root
+  // entry); declare it here so the injection fires.
+  slots.register({
+    name: 'root',
+    children: { 'settings.section': { kind: 'list', scope: 'root' } },
+  } as never, () => null)
+  const fiber = ctx.plugin({ inject: [...inject], apply })
+  await fiber.await()
+  return { ctx, slots, locale, fiber, binds }
+}
+
+describe('skills-manager client apply', () => {
+  it('declares the services it uses', () => {
+    expect(inject).toEqual(['slots', 'locale', 'remote', 'settingsScope'])
+  })
+
+  it('keys the page on the settings namespace the Host serves', () => {
+    expect(SKILLS_MANAGER_NS).toBe('skills-manager')
+  })
+
+  it('registers the card dictionary under the card namespace', async () => {
+    const { locale } = await bench()
+
+    expect(locale.bind(NS)('title')).toBe('技能（Skills）')
+    expect(locale.bind(NS)('remove')).toBe('删除')
+  })
+
+  it('binds the namespace scope and registers one section ided on it', async () => {
+    const { slots, binds } = await bench()
+
+    expect(binds).toEqual([{ namespace: 'skills-manager' }])
+    const entries = slots.entries('settings.section')
+    expect(entries).toHaveLength(1)
+    expect(entries[0]!.options.id).toBe('skills-manager')
+    // Below Agent presets (20) and the MCP servers page (25), above anything
+    // that claims a later seat.
+    expect(entries[0]!.options.order).toBe(26)
+    expect(entries[0]!.locale).toBe(NS)
+    expect(resolveSlotLabel(entries[0]!.options.label)).toBe('技能（Skills）')
+  })
+
+  it('injects the card controller face, seeded from the bound scope', async () => {
+    const { slots } = await bench()
+
+    const entry = slots.entries('settings.section')[0]!
+    const face = (entry.inject as unknown as () => { hooks: { skillsManagerCard: { getSnapshot(): unknown } } })()
+    expect(face.hooks.skillsManagerCard.getSnapshot()).toMatchObject({
+      available: true,
+      writable: true,
+      skills: [],
+      query: '',
+      page: 0,
+      pageCount: 1,
+      visible: [],
+      dialogOpen: false,
+      editing: null,
+    })
+  })
+
+  it('collapses the dictionary and the section registration on teardown', async () => {
+    const { slots, locale, fiber } = await bench()
+    expect(slots.entries('settings.section')).toHaveLength(1)
+
+    await fiber.dispose()
+
+    expect(slots.entries('settings.section')).toHaveLength(0)
+    // Unregistered copy falls back to the key rather than a stale translation.
+    expect(locale.bind(NS)('title')).toBe('title')
+  })
+})
diff --git a/packages/skill/skills-manager/tests/manager.spec.ts b/packages/skill/skills-manager/tests/manager.spec.ts
