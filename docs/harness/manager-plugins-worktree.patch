+/**
+ * Card controller unit tests: the pure bridge between the `skills-manager`
+ * settings scope and the card's form model. A fake scope stands in for the
+ * browser transport, so draft parsing, validation, and every gesture are
+ * exercised without a DOM or a Host.
+ */
+
+import { describe, expect, it, vi } from 'vitest'
+import type { SettingsScope, SettingsScopeSnapshot } from '@deepseek-ai/dsh-client-ui-settings/client'
+import {
+  draftToSkill,
+  matches,
+  SKILLS_MANAGER_PAGE_SIZE,
+  SkillsManagerCardController,
+  toView,
+  type DraftState,
+  type SkillsManagerCardFace,
+  type SkillsManagerSettings,
+  type StoredSkill,
+} from '../src/client/card-controller.ts'
+import { en, zh } from '../src/client/locales.ts'
+
+/** One `skills` write captured from {@link FakeScope.set}. */
+interface WriteCall {
+  readonly field: string
+  readonly value: unknown
+}
+
+/** A controllable SettingsScope face for one namespace. */
+class FakeScope {
+  status: SettingsScopeSnapshot<SkillsManagerSettings>['status'] = 'ready'
+  value: SkillsManagerSettings | undefined
+  writable = true
+  /** When set, `set` rejects with this error. */
+  failWith: Error | undefined
+  readonly calls: WriteCall[] = []
+  private readonly listeners = new Set<() => void>()
+
+  constructor(value?: SkillsManagerSettings) {
+    this.value = value
+  }
+
+  getSnapshot(): SettingsScopeSnapshot<SkillsManagerSettings> {
+    return {
+      status: this.status,
+      value: this.value,
+      base: undefined,
+      user: undefined,
+      revision: 1,
+      writable: this.writable,
+      mode: 'host',
+    }
+  }
+
+  subscribe(listener: () => void): () => void {
+    this.listeners.add(listener)
+    return () => { this.listeners.delete(listener) }
+  }
+
+  mutate(): Promise<void> {
+    return Promise.resolve()
+  }
+
+  set(field: string, value: unknown): Promise<void> {
+    this.calls.push({ field, value })
+    return this.failWith === undefined ? Promise.resolve() : Promise.reject(this.failWith)
+  }
+
+  unset(): Promise<void> {
+    return Promise.resolve()
+  }
+
+  /** Republish the current value, as a Host update would. */
+  emit(): void {
+    for (const listener of [...this.listeners]) listener()
+  }
+
+  /** This fake viewed through the interface the controller consumes. */
+  asScope(): SettingsScope<SkillsManagerSettings> {
+    return this
+  }
+}
+
+/** Mount a controller over a fake scope and hand back both. */
+function mounted(value?: SkillsManagerSettings): {
+  scope: FakeScope
+  controller: SkillsManagerCardController
+  face: SkillsManagerCardFace
+} {
+  const scope = new FakeScope(value)
+  const controller = new SkillsManagerCardController(scope.asScope())
+  return { scope, controller, face: controller.inject() }
+}
+
+/** The face's snapshot, read through the injected store. */
+function state(face: SkillsManagerCardFace): ReturnType<SkillsManagerCardFace['hooks']['skillsManagerCard']['getSnapshot']> {
+  return face.hooks.skillsManagerCard.getSnapshot()
+}
+
+/** The single `skills` array the last write carried. */
+function lastSkills(scope: FakeScope): unknown {
+  const call = scope.calls.at(-1)
+  expect(call?.field).toBe('skills')
+  return call?.value
+}
+
+/** One stored skill with valid defaults. */
+function skill(overrides: Partial<StoredSkill> = {}): StoredSkill {
+  return { name: 'sample', description: 'A sample skill', content: '# Steps\n', ...overrides }
+}
+
+/** One draft with valid defaults, ready to overwrite. */
+function draft(overrides: Partial<DraftState> = {}): DraftState {
+  return {
+    name: '',
+    description: '',
+    whenToUse: '',
+    content: '',
+    modelInvocable: true,
+    userInvocable: true,
+    ...overrides,
+  }
+}
+
+describe('card dictionaries', () => {
+  it('keeps both locales on the same key set', () => {
+    expect(Object.keys(en).sort()).toEqual(Object.keys(zh).sort())
+  })
+})
+
+describe('toView', () => {
+  it('decodes an entry that omits its optional flags', () => {
+    expect(toView(skill())).toEqual({
+      name: 'sample',
+      description: 'A sample skill',
+      enabled: true,
+      modelInvocable: true,
+      userInvocable: true,
+      characters: 8,
+      problems: [],
+    })
+  })
+
+  it('decodes explicit opt-outs and a disabled entry', () => {
+    const view = toView(skill({ disableModelInvocation: true, userInvocable: false, enabled: false }))
+
+    expect(view).toMatchObject({ enabled: false, modelInvocable: false, userInvocable: false })
+  })
+
+  it('flags every entry the Host could refuse', () => {
+    expect(toView(skill({ name: 'Bad Name' })).problems).toEqual(['problemName'])
+    expect(toView(skill({ name: 'a'.repeat(65) })).problems).toEqual(['problemName'])
+    expect(toView(skill({ description: '   ' })).problems).toEqual(['problemDescription'])
+    expect(toView(skill({ description: 'd'.repeat(1_025) })).problems).toEqual(['problemDescription'])
+    expect(toView(skill({ whenToUse: 'w'.repeat(1_025) })).problems).toEqual(['problemWhenToUse'])
+    expect(toView(skill({ content: '  ' })).problems).toEqual(['problemContent'])
+    expect(toView(skill({ content: 'c'.repeat(262_145) })).problems).toEqual(['problemContent'])
+  })
+})
+
+describe('matches', () => {
+  const view = toView(skill({ name: 'Release-Notes', description: 'Draft release notes' }))
+
+  it('matches everything for a blank query', () => {
+    expect(matches(view, '   ')).toBe(true)
+  })
+
+  it('matches the name or the description, case-insensitively', () => {
+    expect(matches(view, ' RELEASE ')).toBe(true)
+    expect(matches(view, 'release NOTES')).toBe(true)
+    expect(matches(view, 'missing')).toBe(false)
+  })
+})
+
+describe('draftToSkill', () => {
+  it('refuses every field the Host would refuse', () => {
+    expect(draftToSkill(draft({ name: 'Bad Name', description: 'd', content: 'c' }))).toEqual({ error: 'errorName' })
+    expect(draftToSkill(draft({ name: 'a'.repeat(65), description: 'd', content: 'c' }))).toEqual({ error: 'errorName' })
+    expect(draftToSkill(draft({ name: 'ok', description: '  ', content: 'c' }))).toEqual({ error: 'errorDescription' })
+    expect(draftToSkill(draft({ name: 'ok', description: 'd'.repeat(1_025), content: 'c' }))).toEqual({ error: 'errorDescription' })
+    expect(draftToSkill(draft({ name: 'ok', description: 'd', whenToUse: 'w'.repeat(1_025), content: 'c' }))).toEqual({ error: 'errorWhenToUse' })
+    expect(draftToSkill(draft({ name: 'ok', description: 'd', content: '  ' }))).toEqual({ error: 'errorContent' })
+    expect(draftToSkill(draft({ name: 'ok', description: 'd', content: 'c'.repeat(262_145) }))).toEqual({ error: 'errorContent' })
+  })
+
+  it('trims the routing text and drops the optional fields a full draft leaves unset', () => {
+    expect(draftToSkill(draft({ name: ' ok ', description: ' d ', content: 'body' }))).toEqual({
+      skill: { name: 'ok', description: 'd', content: 'body' },
+    })
+  })
+
+  it('carries the when-to-use note and the invocation opt-outs', () => {
+    expect(draftToSkill(draft({
+      name: 'ok',
+      description: 'd',
+      whenToUse: ' when asked ',
+      content: 'body',
+      modelInvocable: false,
+      userInvocable: false,
+    }))).toEqual({
+      skill: { name: 'ok', description: 'd', whenToUse: 'when asked', content: 'body', disableModelInvocation: true, userInvocable: false },
+    })
+  })
+})
+
+describe('SkillsManagerCardController projection', () => {
+  it('projects the scope value into skill views', () => {
+    const { face } = mounted({ skills: [skill(), skill({ name: 'other', enabled: false, disableModelInvocation: true })] })
+
+    const snapshot = state(face)
