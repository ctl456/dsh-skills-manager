index 0000000000..7666674142
--- /dev/null
+++ b/packages/skill/skills-manager/tests/manager.spec.ts
@@ -0,0 +1,314 @@
+/**
+ * Integration tests for the skills manager: the plugin registers one
+ * `ctx.skills` provider over a settings-backed registry, so a skill added from
+ * chat — or by the browser card writing the same section — is immediately
+ * listed by the shipped registry and its body loads through the same seam the
+ * `skill` tool uses.
+ *
+ * The registry, the tool runtime, and the settings service are the real
+ * shipped plugins; only the settings provider is an in-memory stub, because
+ * the file-backed one is covered where it lives.
+ */
+
+import { describe, expect, it } from 'vitest'
+import { Context, type Fiber } from '@deepseek-ai/cordis'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { type ToolExecutionInput } from '@deepseek-ai/dsh-tools'
+import { SettingsProvider } from '@deepseek-ai/dsh-settings'
+import type { SettingsNamespace } from '@deepseek-ai/dsh-settings'
+import SkillRegistry from '@deepseek-ai/dsh-skill'
+import * as manager from '../src/index.ts'
+import { SETTINGS_NS, type StoredSkill } from '../src/skills.ts'
+
+/** In-memory settings provider: the manager's persisted registry, for tests. */
+class MemorySettings extends SettingsProvider {
+  /** The stored section per namespace. */
+  readonly doc: Record<string, unknown> = {}
+  /** A writable provider records through {@link persist}. */
+  override readonly writable = true
+  /** Reject the next write, to exercise the rollback path. */
+  rejectNext = false
+
+  protected load(): Promise<Record<string, unknown>> {
+    return Promise.resolve(structuredClone(this.doc))
+  }
+
+  protected persist(ns: SettingsNamespace, section: Record<string, unknown>): Promise<void> {
+    if (this.rejectNext) {
+      this.rejectNext = false
+      return Promise.reject(new Error('settings write refused'))
+    }
+    this.doc[ns] = structuredClone(section)
+    return Promise.resolve()
+  }
+}
+
+/** Build a valid stored skill, applying overrides. */
+function skill(overrides: Partial<StoredSkill> = {}): StoredSkill {
+  return {
+    name: 'release-notes',
+    description: 'Write release notes from the merged pull requests.',
+    content: '# Release notes\n\n1. Read the git log.\n',
+    ...overrides,
+  }
+}
+
+/** One registry-tool call, with the branded call id the registry expects. */
+function call(name: string, args: unknown): ToolExecutionInput {
+  return {
+    callId: `call-${name}` as ToolExecutionInput['callId'],
+    name,
+    arguments: args,
+    signal: new AbortController().signal,
+  }
+}
+
+interface Bench {
+  readonly ctx: Context
+  readonly settings: MemorySettings
+  readonly fiber: Fiber
+}
+
+/** Mount the shipped registry, tool runtime, and settings service, then the manager. */
+async function bench(config: { skills?: StoredSkill[]; providerName?: string; rank?: number; tools?: boolean } = {}): Promise<Bench> {
+  const ctx = new Context()
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  await ctx.plugin(SkillRegistry)
+  await ctx.plugin(MemorySettings)
+  const fiber = ctx.plugin(manager, { skills: [], ...config })
+  await fiber.await()
+  return { ctx, settings: ctx.settings as MemorySettings, fiber }
+}
+
+/** The names the registry currently resolves, in catalog order. */
+async function names(ctx: Context): Promise<string[]> {
+  return (await ctx.skills.list()).map(summary => summary.name)
+}
+
+describe('registry provider registration', () => {
+  it('publishes a skill seeded from the composition entry', async () => {
+    const { ctx } = await bench({ skills: [skill()] })
+
+    expect(await names(ctx)).toEqual(['release-notes'])
+    await expect(ctx.skills.get('release-notes')).resolves.toMatchObject({
+      name: 'release-notes',
+      provider: 'skills-manager',
+      content: '# Release notes\n\n1. Read the git log.',
+      invocation: { modelInvocable: true, userInvocable: true },
+    })
+  })
+
+  it('honours a custom provider name and rank', async () => {
+    const { ctx } = await bench({ skills: [skill()], providerName: 'house-skills', rank: 120 })
+
+    const summary = (await ctx.skills.list())[0]!
+    expect(summary.provider).toBe('house-skills')
+    expect((await ctx.skills.get('release-notes'))?.provider).toBe('house-skills')
+  })
+
+  it('withdraws the provider and its skills when the plugin unloads', async () => {
+    const { ctx, fiber } = await bench({ skills: [skill()] })
+    expect(await names(ctx)).toEqual(['release-notes'])
+
+    await fiber.dispose()
+
+    expect(await names(ctx)).toEqual([])
+    await expect(ctx.skills.get('release-notes')).resolves.toBeUndefined()
+  })
+
+  it('registers the four management tools, and none when tools are disabled', async () => {
+    const { ctx } = await bench()
+    expect(ctx.tools.get('skills_manager_list')).toBeDefined()
+    expect(ctx.tools.get('skills_manager_add')).toBeDefined()
+    expect(ctx.tools.get('skills_manager_remove')).toBeDefined()
+    expect(ctx.tools.get('skills_manager_set_enabled')).toBeDefined()
+
+    const off = await bench({ tools: false })
+    expect(off.ctx.tools.get('skills_manager_list')).toBeUndefined()
+  })
+})
+
+describe('runtime edits', () => {
+  it('adds a skill from chat, and the registry loads it on the next call', async () => {
+    const { ctx, settings } = await bench()
+
+    const added = await ctx.tools.execute(call('skills_manager_add', {
+      name: 'triage-issues',
+      description: 'Triage the incoming issue queue.',
+      content: 'Read the queue, label, and assign.',
+    }))
+
+    expect(added.isError).toBe(false)
+    // No polling: the manager invalidates the completed catalog on write, so
+    // the very next discovery sees the new skill.
+    expect(await names(ctx)).toEqual(['triage-issues'])
+    await expect(ctx.skills.get('triage-issues')).resolves.toMatchObject({
+      content: 'Read the queue, label, and assign.',
+    })
+    expect((settings.doc[SETTINGS_NS] as { skills: StoredSkill[] }).skills.map(entry => entry.name))
+      .toEqual(['triage-issues'])
+  })
+
+  it('replaces an entry with the same name instead of duplicating it', async () => {
+    const { ctx } = await bench({ skills: [skill({ content: 'first' })] })
+
+    await ctx.tools.execute(call('skills_manager_add', {
+      name: 'release-notes',
+      description: 'Write release notes from the merged pull requests.',
+      content: 'second',
+    }))
+
+    expect(await names(ctx)).toEqual(['release-notes'])
+    await expect(ctx.skills.get('release-notes')).resolves.toMatchObject({ content: 'second' })
+  })
+
+  it('withdraws and restores one skill through set_enabled, leaving its sibling alone', async () => {
+    const { ctx } = await bench({
+      skills: [skill(), skill({ name: 'triage-issues', description: 'Triage new issues.' })],
+    })
+
+    await ctx.tools.execute(call('skills_manager_set_enabled', { name: 'release-notes', enabled: false }))
+    expect(await names(ctx)).toEqual(['triage-issues'])
+    await expect(ctx.skills.get('release-notes')).resolves.toBeUndefined()
+
+    await ctx.tools.execute(call('skills_manager_set_enabled', { name: 'release-notes', enabled: true }))
+    expect((await names(ctx)).sort()).toEqual(['release-notes', 'triage-issues'])
+    await expect(ctx.skills.get('release-notes')).resolves.toBeDefined()
+  })
+
+  it('drops a removed skill from the catalog', async () => {
+    const { ctx } = await bench({ skills: [skill()] })
+
+    await ctx.tools.execute(call('skills_manager_remove', { name: 'release-notes' }))
+
+    expect(await names(ctx)).toEqual([])
+    await expect(ctx.skills.get('release-notes')).resolves.toBeUndefined()
+  })
+
+  it('treats removing an absent skill and re-enabling an enabled one as no-ops', async () => {
+    const { ctx, settings } = await bench({ skills: [skill()] })
+
+    await ctx.tools.execute(call('skills_manager_remove', { name: 'ghost' }))
+    await ctx.tools.execute(call('skills_manager_set_enabled', { name: 'release-notes', enabled: true }))
+    await ctx.tools.execute(call('skills_manager_set_enabled', { name: 'ghost', enabled: false }))
+
+    expect(await names(ctx)).toEqual(['release-notes'])
+    // Both calls are true no-ops: neither may materialize a section (or an
+    // explicit `enabled` flag) that the user never asked for.
+    expect(settings.doc[SETTINGS_NS]).toBeUndefined()
+  })
+
+  it('rejects an invalid skill without changing the registry', async () => {
+    const { ctx } = await bench()
+
+    const result = await ctx.tools.execute(call('skills_manager_add', {
+      name: 'Bad Name',
+      description: 'x',
+      content: 'y',
+    }))
+
+    expect(result.isError).toBe(true)
+    expect(await names(ctx)).toEqual([])
+    const listed = await ctx.tools.execute(call('skills_manager_list', {}))
+    expect((listed.value as { skills: unknown[] }).skills).toEqual([])
+  })
+
+  it('keeps working in memory when no settings provider is composed', async () => {
+    const ctx = new Context()
+    await ctx.plugin(SystemPrompt)
+    await ctx.plugin(ToolRuntime)
+    await ctx.plugin(SkillRegistry)
+    const fiber = ctx.plugin(manager, { skills: [] })
+    await fiber.await()
+
+    const result = await ctx.tools.execute(call('skills_manager_add', {
+      name: 'release-notes',
+      description: 'Write release notes.',
+      content: 'Read the git log.',
+    }))
+
+    expect(result.isError).toBe(false)
+    expect(await names(ctx)).toEqual(['release-notes'])
+    // The composition entry is the only source here, so listing must read
+    // through the local fallback rather than a settings section that never
+    // arrived.
+    const listed = await ctx.tools.execute(call('skills_manager_list', {}))
+    expect((listed.value as { skills: { name: string }[] }).skills.map(entry => entry.name))
+      .toEqual(['release-notes'])
+    await fiber.dispose()
+  })
+
+  it('reads the built-in defaults when apply runs without the Loader schema', async () => {
+    const bare = new Context()
+    await bare.plugin(SystemPrompt)
+    await bare.plugin(ToolRuntime)
+    await bare.plugin(SkillRegistry)
+    // The Loader validates the entry through the Schemastery schema, which
+    // fills every default; calling apply directly skips that, so the plugin
+    // has to fall back on its own constants.
+    manager.apply(bare, { skills: [] })
+    expect(bare.tools.get('skills_manager_list')).toBeDefined()
+    expect(await names(bare)).toEqual([])
+
+    const degenerate = new Context()
+    await degenerate.plugin(SystemPrompt)
+    await degenerate.plugin(ToolRuntime)
+    await degenerate.plugin(SkillRegistry)
+    // A non-finite rank cannot come through the schema either, but a caller
+    // holding the exported apply must still land on the shipped rank.
+    manager.apply(degenerate, {
+      skills: [],
+      providerName: 'house-skills',
+      rank: Number.NaN,
+      tools: false,
+    })
+    expect(degenerate.tools.get('skills_manager_list')).toBeUndefined()
+  })
+})
+
+describe('settings section', () => {
+  it('publishes a section write made from another surface, such as the card', async () => {
+    const { ctx, settings } = await bench({ skills: [skill()] })
+    expect(await names(ctx)).toEqual(['release-notes'])
+
+    await ctx.settings.update(SETTINGS_NS, {
+      skills: [skill({ name: 'triage-issues', description: 'Triage new issues.' })],
+    })
+
+    expect(await names(ctx)).toEqual(['triage-issues'])
+    expect((settings.doc[SETTINGS_NS] as { skills: StoredSkill[] }).skills.map(entry => entry.name))
+      .toEqual(['triage-issues'])
+  })
+
+  it('rolls back the cached registry when the settings write is refused', async () => {
+    const { ctx, settings } = await bench()
+    settings.rejectNext = true
+
+    const result = await ctx.tools.execute(call('skills_manager_add', {
+      name: 'denied',
+      description: 'Should not survive.',
+      content: 'nope',
+    }))
+
+    expect(result.isError).toBe(true)
+    expect(await names(ctx)).toEqual([])
+    const listed = await ctx.tools.execute(call('skills_manager_list', {}))
+    expect((listed.value as { skills: { name: string }[] }).skills).toEqual([])
+  })
+
+  it('reports an unpublishable stored entry as problems instead of failing the catalog', async () => {
+    const { ctx } = await bench({
+      skills: [skill(), skill({ name: 'Broken Name', description: '   ', content: '' })],
+    })
+
+    // The good entry still publishes; the bad one is filtered out.
+    expect(await names(ctx)).toEqual(['release-notes'])
+
+    const listed = await ctx.tools.execute(call('skills_manager_list', {}))
+    const skills = (listed.value as { skills: { name: string; problems: string[] }[] }).skills
+    expect(skills.map(entry => entry.name)).toEqual(['release-notes', 'Broken Name'])
+    expect(skills[0]!.problems).toEqual([])
+    expect(skills[1]!.problems).toHaveLength(3)
+  })
+})
diff --git a/packages/skill/skills-manager/tests/provider.spec.ts b/packages/skill/skills-manager/tests/provider.spec.ts
