@@ -0,0 +1,295 @@
+// @vitest-environment jsdom
+
+/**
+ * Card render tests: the JSX projection of one SkillsManagerCardState. Each
+ * spec seeds the state it needs and asserts the controls, the filter/pager
+ * chrome, the add/edit dialog, and the gesture wiring — the controller owns
+ * the semantics.
+ */
+
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { bindSnapshotSelector } from '@deepseek-ai/dsh-client-ui-renderer/src/client/bind.ts'
+import { SkillsManagerCard } from '../src/client/SkillsManagerCard.tsx'
+import type { SkillsManagerCardProps } from '../src/client/SkillsManagerCard.tsx'
+import type { DraftState, SkillView, SkillsManagerCardState } from '../src/client/card-controller.ts'
+import { en } from '../src/client/locales.ts'
+
+afterEach(cleanup)
+
+const t = ((key: string, params?: Record<string, string>) => {
+  const template = en[key as keyof typeof en] ?? key
+  if (params === undefined) return template
+  return template.replace(/\{(\w+)\}/g, (_match, name: string) => params[name] ?? '')
+}) as SkillsManagerCardProps['t']
+
+/** The empty add form. */
+function draft(overrides: Partial<DraftState> = {}): DraftState {
+  return {
+    name: '',
+    description: '',
+    whenToUse: '',
+    content: '',
+    modelInvocable: true,
+    userInvocable: true,
+    ...overrides,
+  }
+}
+
+/** One listed skill with the page the controller would derive for it. */
+function listed(skills: readonly SkillView[], overrides: Partial<SkillsManagerCardState> = {}): Partial<SkillsManagerCardState> {
+  return {
+    skills,
+    matched: skills.length,
+    visible: skills,
+    pageCount: 1,
+    page: 0,
+    ...overrides,
+  }
+}
+
+/** One listed skill view with valid defaults. */
+function view(overrides: Partial<SkillView> = {}): SkillView {
+  return {
+    name: 'release-notes',
+    description: 'Draft the release notes',
+    enabled: true,
+    modelInvocable: true,
+    userInvocable: true,
+    characters: 12,
+    problems: [],
+    ...overrides,
+  }
+}
+
+/**
+ * Reach one control by its stable id. The card's hints ride inside the same
+ * `<label>`, so the wrapping label's text is label+hint; ids are the precise
+ * handle the form itself sets.
+ */
+function control(id: string): HTMLElement {
+  const element = document.getElementById(id)
+  if (element === null) throw new Error(`missing control #${id}`)
+  return element
+}
+
+/** Render the card over a store seeded with the given state. */
+function mount(overrides: Partial<SkillsManagerCardState> = {}) {
+  const store = createSnapshotStore<SkillsManagerCardState>({
+    available: true,
+    writable: true,
+    saving: false,
+    error: null,
+    skills: [],
+    query: '',
+    matched: 0,
+    page: 0,
+    pageCount: 1,
+    visible: [],
+    dialogOpen: false,
+    editing: null,
+    draft: draft(),
+    ...overrides,
+  })
+  const setQuery = vi.fn()
+  const setPage = vi.fn()
+  const openAdd = vi.fn()
+  const openEdit = vi.fn()
+  const closeDialog = vi.fn()
+  const edit = vi.fn()
+  const setModelInvocable = vi.fn()
+  const setUserInvocable = vi.fn()
+  const submit = vi.fn()
+  const remove = vi.fn()
+  const setEnabled = vi.fn()
+  const resetDraft = vi.fn()
+  const props = {
+    t,
+    setQuery,
+    setPage,
+    openAdd,
+    openEdit,
+    closeDialog,
+    edit,
+    setModelInvocable,
+    setUserInvocable,
+    submit,
+    remove,
+    setEnabled,
+    resetDraft,
+    useSkillsManagerCard: bindSnapshotSelector(store),
+  } as unknown as SkillsManagerCardProps
+  const view = render(<SkillsManagerCard {...props} />)
+  return {
+    view, store, setQuery, setPage, openAdd, openEdit, closeDialog, edit,
+    setModelInvocable, setUserInvocable, submit, remove, setEnabled, resetDraft,
+  }
+}
+
+describe('SkillsManagerCard', () => {
+  it('renders nothing while the Host does not serve the namespace', () => {
+    const { view } = mount({ available: false })
+
+    expect(view.container.firstChild).toBeNull()
+  })
+
+  it('renders the header and the empty state', () => {
+    mount()
+
+    expect(screen.getByRole('heading', { name: 'Skills' })).toBeTruthy()
+    expect(screen.getByText(/Manage the skills the harness can use/)).toBeTruthy()
+    expect(screen.getByText(/No skill is configured yet/)).toBeTruthy()
+    expect(document.getElementById('skills-manager-search')).toBeTruthy()
+  })
+
+  it('explains an empty filter result without claiming no skill exists', () => {
+    mount(listed([view()], { visible: [] }))
+
+    expect(screen.getByText(/No skill matches the filter/)).toBeTruthy()
+  })
+
+  it('wires the search box', () => {
+    const { setQuery } = mount()
+
+    fireEvent.change(control('skills-manager-search'), { target: { value: 'notes' } })
+    expect(setQuery).toHaveBeenCalledWith('notes')
+  })
+
+  it('opens the add dialog from the toolbar and stages each field', () => {
+    const { openAdd } = mount()
+
+    fireEvent.click(screen.getByRole('button', { name: 'Add skill' }))
+    expect(openAdd).toHaveBeenCalledOnce()
+
+    cleanup()
+    const open = mount({ dialogOpen: true })
+
+    expect(screen.getByRole('dialog')).toBeTruthy()
+    expect(screen.getByText('Add a skill')).toBeTruthy()
+    expect(control('skills-manager-name')).toBeTruthy()
+    expect(control('skills-manager-description')).toBeTruthy()
+    expect(control('skills-manager-when-to-use')).toBeTruthy()
+    expect(control('skills-manager-content')).toBeTruthy()
+
+    fireEvent.change(control('skills-manager-name'), { target: { value: 'release-notes' } })
+    expect(open.edit).toHaveBeenCalledWith('name', 'release-notes')
+    fireEvent.change(control('skills-manager-description'), { target: { value: 'Draft notes' } })
+    expect(open.edit).toHaveBeenCalledWith('description', 'Draft notes')
+    fireEvent.change(control('skills-manager-when-to-use'), { target: { value: 'when asked' } })
+    expect(open.edit).toHaveBeenCalledWith('whenToUse', 'when asked')
+    fireEvent.change(control('skills-manager-content'), { target: { value: '1. Collect\n' } })
+    expect(open.edit).toHaveBeenCalledWith('content', '1. Collect\n')
+  })
+
+  it('renders the edit dialog with the name locked and the toggles wired', () => {
+    const { setModelInvocable, setUserInvocable } = mount({
+      dialogOpen: true,
+      editing: 'release-notes',
+      draft: draft({ name: 'release-notes', description: 'd', content: 'c' }),
+    })
+
+    expect(screen.getByText('Edit skill')).toBeTruthy()
+    expect(control('skills-manager-name')).toHaveProperty('disabled', true)
+
+    fireEvent.click(control('skills-manager-model-invocable'))
+    expect(setModelInvocable).toHaveBeenCalledWith(false)
+    fireEvent.click(control('skills-manager-user-invocable'))
+    expect(setUserInvocable).toHaveBeenCalledWith(false)
+  })
+
+  it('closes the dialog from cancel, the close control, and the scrim', () => {
+    const { closeDialog } = mount({ dialogOpen: true })
+
+    fireEvent.click(screen.getByRole('button', { name: 'Cancel' }))
+    fireEvent.click(screen.getByRole('button', { name: 'Close' }))
+    expect(closeDialog).toHaveBeenCalledTimes(2)
+  })
+
+  it('fires save and clear from the dialog', () => {
+    const { submit, resetDraft } = mount({
+      dialogOpen: true,
+      draft: draft({ name: 'release-notes', description: 'd', content: 'c' }),
+    })
+
+    fireEvent.click(screen.getByRole('button', { name: 'Save' }))
+    expect(submit).toHaveBeenCalledOnce()
+    fireEvent.click(screen.getByRole('button', { name: 'Clear' }))
+    expect(resetDraft).toHaveBeenCalledOnce()
+  })
+
+  it('states the refusal and disables every control while the document is read-only', () => {
+    mount({ writable: false, dialogOpen: true })
+
+    expect(screen.getByText(/read-only/)).toBeTruthy()
+    expect(control('skills-manager-name')).toHaveProperty('disabled', true)
+    expect(screen.getByRole('button', { name: 'Save' })).toHaveProperty('disabled', true)
+    expect(screen.getByRole('button', { name: 'Add skill' })).toHaveProperty('disabled', true)
+  })
+
+  it('lists configured skills with their badges, size, problems, and gestures', () => {
+    const { openEdit, setEnabled, remove } = mount(listed([
+      view({ name: 'release-notes', enabled: true }),
+      view({ name: 'changelog', description: 'Keep the changelog', enabled: false, modelInvocable: false, characters: 30, problems: ['problemName'] }),
+    ]))
+
+    expect(screen.getAllByText('Enabled')).toHaveLength(1)
+    expect(screen.getAllByText('Disabled')).toHaveLength(1)
+    expect(screen.getByText('12 characters')).toBeTruthy()
+    expect(screen.getByText('The name is not valid kebab-case.')).toBeTruthy()
+
+    fireEvent.click(screen.getAllByRole('button', { name: 'Edit' })[1]!)
+    expect(openEdit).toHaveBeenCalledWith('changelog')
+    fireEvent.click(screen.getByRole('button', { name: 'Disable' }))
+    expect(setEnabled).toHaveBeenCalledWith('release-notes', false)
+    fireEvent.click(screen.getByRole('button', { name: 'Enable' }))
+    expect(setEnabled).toHaveBeenCalledWith('changelog', true)
+    fireEvent.click(screen.getAllByRole('button', { name: 'Remove' })[0]!)
+    expect(remove).toHaveBeenCalledWith('release-notes')
+  })
+
+  it('pages the list and disables the arrow at each end', () => {
+    const { setPage } = mount(listed([view()], { matched: 12, page: 1, pageCount: 3 }))
+
+    expect(screen.getByText('Page 2 of 3')).toBeTruthy()
