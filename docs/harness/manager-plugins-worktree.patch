+// @vitest-environment jsdom
+
+/**
+ * Card render tests: the JSX projection of one McpManagerCardState. Each spec
+ * seeds the state it needs and asserts the controls, the transport-dependent
+ * fields, the filter/pager chrome, and the gesture wiring — the controller
+ * owns the semantics.
+ */
+
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { bindSnapshotSelector } from '@deepseek-ai/dsh-client-ui-renderer/src/client/bind.ts'
+import { McpManagerCard } from '../src/client/McpManagerCard.tsx'
+import type { McpManagerCardProps } from '../src/client/McpManagerCard.tsx'
+import type { DraftState, McpManagerCardState, ServerView } from '../src/client/card-controller.ts'
+import { en } from '../src/client/locales.ts'
+
+afterEach(cleanup)
+
+const t = ((key: string, params?: Record<string, string>) => {
+  const template = en[key as keyof typeof en] ?? key
+  if (params === undefined) return template
+  return template.replace(/\{(\w+)\}/g, (_match, name: string) => params[name] ?? '')
+}) as McpManagerCardProps['t']
+
+/** The empty add form. */
+function draft(overrides: Partial<DraftState> = {}): DraftState {
+  return {
+    name: '',
+    transport: 'stdio',
+    command: '',
+    args: '',
+    env: '',
+    cwd: '',
+    url: '',
+    headers: '',
+    toolCallTimeoutMs: '',
+    ...overrides,
+  }
+}
+
+/** One listed server with the page the controller would derive for it. */
+function listed(servers: readonly ServerView[], overrides: Partial<McpManagerCardState> = {}): Partial<McpManagerCardState> {
+  return {
+    servers,
+    matched: servers.length,
+    visible: servers,
+    pageCount: 1,
+    page: 0,
+    ...overrides,
+  }
+}
+
+/**
+ * Reach one control by its stable id. The card's hints ride inside the same
+ * `<label>`, so the wrapping label's text is label+hint; ids are the precise
+ * handle the form itself sets.
+ */
+function control(id: string): HTMLElement {
+  const element = document.getElementById(id)
+  if (element === null) throw new Error(`missing control #${id}`)
+  return element
+}
+
+/** Render the card over a store seeded with the given state. */
+function mount(overrides: Partial<McpManagerCardState> = {}) {
+  const store = createSnapshotStore<McpManagerCardState>({
+    available: true,
+    writable: true,
+    saving: false,
+    error: null,
+    servers: [],
+    query: '',
+    matched: 0,
+    page: 0,
+    pageCount: 1,
+    visible: [],
+    addOpen: false,
+    draft: draft(),
+    ...overrides,
+  })
+  const close = vi.fn()
+  const setQuery = vi.fn()
+  const setPage = vi.fn()
+  const openAdd = vi.fn()
+  const closeAdd = vi.fn()
+  const edit = vi.fn()
+  const setTransport = vi.fn()
+  const add = vi.fn()
+  const remove = vi.fn()
+  const setEnabled = vi.fn()
+  const resetDraft = vi.fn()
+  const props = {
+    t,
+    close,
+    setQuery,
+    setPage,
+    openAdd,
+    closeAdd,
+    edit,
+    setTransport,
+    add,
+    remove,
+    setEnabled,
+    resetDraft,
+    useMcpManagerCard: bindSnapshotSelector(store),
+  } as unknown as McpManagerCardProps
+  const view = render(<McpManagerCard {...props} />)
+  return {
+    view, store, setQuery, setPage, openAdd, closeAdd, edit, setTransport, add, remove, setEnabled, resetDraft,
+  }
+}
+
+describe('McpManagerCard', () => {
+  it('renders nothing while the Host does not serve the namespace', () => {
+    const { view } = mount({ available: false })
+
+    expect(view.container.firstChild).toBeNull()
+    expect(screen.queryByText('MCP servers')).toBeNull()
+  })
+
+  it('shows the empty list beside the filter and the add button', () => {
+    mount()
+
+    expect(screen.getByText('MCP servers')).toBeTruthy()
+    expect(screen.getByText(/No MCP server is configured yet/)).toBeTruthy()
+    expect(screen.getByLabelText('Search servers')).toBeTruthy()
+    expect(screen.getByRole('button', { name: 'Add server' })).toBeTruthy()
+    // The add form only exists inside the dialog, which starts closed.
+    expect(document.getElementById('mcp-manager-name')).toBeNull()
+    expect(screen.queryByRole('dialog')).toBeNull()
+  })
+
+  it('filters through the search box', () => {
+    const { setQuery } = mount()
+
+    fireEvent.change(control('mcp-manager-search'), { target: { value: 'files' } })
+    expect(setQuery).toHaveBeenCalledWith('files')
+  })
+
+  it('opens the add dialog and stages the stdio fields', () => {
+    const { openAdd } = mount()
+
+    fireEvent.click(screen.getByRole('button', { name: 'Add server' }))
+    expect(openAdd).toHaveBeenCalledOnce()
+
+    cleanup()
+    const open = mount({ addOpen: true })
+
+    expect(screen.getByRole('dialog')).toBeTruthy()
+    expect(screen.getByText('Add an MCP server')).toBeTruthy()
+    expect(control('mcp-manager-command')).toBeTruthy()
+    expect(control('mcp-manager-cwd')).toBeTruthy()
+    expect(document.getElementById('mcp-manager-url')).toBeNull()
+    expect(document.getElementById('mcp-manager-headers')).toBeNull()
+
+    fireEvent.change(control('mcp-manager-name'), { target: { value: 'files' } })
+    expect(open.edit).toHaveBeenCalledWith('name', 'files')
+    fireEvent.change(control('mcp-manager-args'), { target: { value: '-y\nserver-filesystem' } })
+    expect(open.edit).toHaveBeenCalledWith('args', '-y\nserver-filesystem')
+  })
+
+  it('switches the visible fields with the selected transport', () => {
+    const { setTransport } = mount({ addOpen: true })
+
+    fireEvent.change(control('mcp-manager-transport'), { target: { value: 'streamable-http' } })
+    expect(setTransport).toHaveBeenCalledWith('streamable-http')
+
+    cleanup()
+    const remote = mount({ addOpen: true, draft: draft({ transport: 'streamable-http' }) })
+    expect(control('mcp-manager-url')).toBeTruthy()
+    expect(document.getElementById('mcp-manager-command')).toBeNull()
+    fireEvent.change(control('mcp-manager-headers'), { target: { value: 'Authorization: Bearer x' } })
+    expect(remote.edit).toHaveBeenCalledWith('headers', 'Authorization: Bearer x')
+  })
+
+  it('closes the dialog from the cancel button and the close control', () => {
+    const { closeAdd } = mount({ addOpen: true })
+
+    fireEvent.click(screen.getByRole('button', { name: 'Cancel' }))
+    fireEvent.click(screen.getByRole('button', { name: 'Close' }))
+    expect(closeAdd).toHaveBeenCalledTimes(2)
+  })
+
+  it('states the refusal and disables every control while the document is read-only', () => {
+    mount({ writable: false, addOpen: true })
+
+    expect(screen.getByText(/read-only/)).toBeTruthy()
+    expect(control('mcp-manager-name')).toHaveProperty('disabled', true)
+    expect(screen.getAllByRole('button', { name: 'Add' })[0]).toHaveProperty('disabled', true)
+  })
+
+  it('lists configured servers with their badges and gestures', () => {
+    const { setEnabled, remove } = mount(listed([
+      { name: 'files', transport: 'stdio', enabled: true, target: 'npx -y server-filesystem' },
+      { name: 'web', transport: 'streamable-http', enabled: false, target: 'https://example.test/mcp' },
+    ]))
+
+    expect(screen.getByText(/npx -y server-filesystem/)).toBeTruthy()
+    expect(screen.getByText(/https:\/\/example.test\/mcp/)).toBeTruthy()
+    expect(screen.getByText('Enabled')).toBeTruthy()
+    expect(screen.getByText('Disabled')).toBeTruthy()
+
+    fireEvent.click(screen.getByRole('button', { name: 'Disable' }))
+    expect(setEnabled).toHaveBeenCalledWith('files', false)
+    fireEvent.click(screen.getByRole('button', { name: 'Enable' }))
+    expect(setEnabled).toHaveBeenCalledWith('web', true)
+    fireEvent.click(screen.getAllByRole('button', { name: 'Remove' })[0]!)
+    expect(remove).toHaveBeenCalledWith('files')
+  })
+
+  it('explains an empty filter result without claiming no server exists', () => {
+    mount(listed([{ name: 'files', transport: 'stdio', enabled: true, target: 'npx' }], { visible: [] }))
+
+    expect(screen.getByText(/No MCP server matches the filter/)).toBeTruthy()
+  })
+
+  it('pages the list and disables the arrow at each end', () => {
+    const { setPage } = mount({
+      servers: [{ name: 'files', transport: 'stdio', enabled: true, target: 'npx' }],
+      matched: 12,
+      page: 1,
+      pageCount: 3,
+      visible: [{ name: 'files', transport: 'stdio', enabled: true, target: 'npx' }],
+    })
+
+    expect(screen.getByText('Page 2 of 3')).toBeTruthy()
+    fireEvent.click(screen.getByRole('button', { name: 'Previous page' }))
+    expect(setPage).toHaveBeenCalledWith(0)
+    fireEvent.click(screen.getByRole('button', { name: 'Next page' }))
+    expect(setPage).toHaveBeenCalledWith(2)
+
+    cleanup()
+    mount({ page: 0, pageCount: 3 })
+    expect(screen.getByRole('button', { name: 'Previous page' })).toHaveProperty('disabled', true)
+    cleanup()
+    mount({ page: 2, pageCount: 3 })
+    expect(screen.getByRole('button', { name: 'Next page' })).toHaveProperty('disabled', true)
+  })
+
+  it('hides the pager while the list fits one page', () => {
+    mount(listed([{ name: 'files', transport: 'stdio', enabled: true, target: 'npx' }]))
+
+    expect(screen.queryByRole('button', { name: 'Previous page' })).toBeNull()
+    expect(screen.queryByRole('button', { name: 'Next page' })).toBeNull()
+  })
+
+  it('shows the localized refusal and fires add and clear', () => {
+    const { add, resetDraft } = mount({ addOpen: true, error: 'errorCommand' })
+
+    expect(screen.getByText('A stdio server needs a command.')).toBeTruthy()
+    fireEvent.click(screen.getByRole('button', { name: 'Add' }))
+    expect(add).toHaveBeenCalledOnce()
+    fireEvent.click(screen.getByRole('button', { name: 'Clear' }))
+    expect(resetDraft).toHaveBeenCalledOnce()
+  })
+
+  it('locks the form while a write is crossing the wire', () => {
+    mount({ saving: true, addOpen: true, draft: draft({ name: 'files', command: 'npx' }) })
+
+    expect(screen.getByRole('button', { name: 'Add server' })).toHaveProperty('disabled', true)
+    expect(screen.getByRole('button', { name: 'Add' })).toHaveProperty('disabled', true)
+    expect(screen.getByRole('button', { name: 'Cancel' })).toHaveProperty('disabled', true)
+    expect(control('mcp-manager-name')).toHaveProperty('disabled', true)
+  })
+})
