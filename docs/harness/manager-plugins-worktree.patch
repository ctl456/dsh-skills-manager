@@ -0,0 +1,75 @@
+/**
+ * End-to-end test for the MCP manager over the REAL MCP protocol: the manager
+ * mounts the real `dsh-mcp-client`, which spawns the stdio fixture server, and
+ * the fixture's tools become callable harness tools under `mcp__<name>__`.
+ *
+ * This is the "the harness can actually call MCP" proof: nothing about the MCP
+ * SDK, transports, or tool bridge is mocked. Adding and removing the server
+ * runs through the manager's own model-facing tools.
+ */
+
+import { fileURLToPath } from 'node:url'
+import { afterAll, describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { type ToolExecutionInput } from '@deepseek-ai/dsh-tools'
+import * as McpManager from '../src/index.ts'
+
+// The shared fixture server lives beside the mcp-client e2e suite; Node's
+// native type stripping runs it directly (its imports resolve through
+// mcp-client's own node_modules).
+const fixtureServerPath = fileURLToPath(new URL('../../mcp-client/tests/fixture-server.ts', import.meta.url))
+const fixtureCwd = fileURLToPath(new URL('../../mcp-client', import.meta.url))
+
+/** One registry-tool call, with the branded call id the registry expects. */
+function call(name: string, args: unknown): ToolExecutionInput {
+  return {
+    callId: `e2e-${name}` as ToolExecutionInput['callId'],
+    name,
+    arguments: args,
+    signal: new AbortController().signal,
+  }
+}
+
+/** Mount the harness services the manager injects. */
+async function mountHarness(): Promise<Context> {
+  const ctx = new Context()
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  return ctx
+}
+
+describe('mcp-manager end-to-end over a real MCP stdio server', () => {
+  let ctx: Context | undefined
+
