index 0000000000..ea1f3863d6
--- /dev/null
+++ b/packages/skill/skills-manager/tests/provider.spec.ts
@@ -0,0 +1,121 @@
+/** Tests for the managed provider: what it publishes, what it skips, and what it loads. */
+
+import { describe, expect, it, vi } from 'vitest'
+import type { SkillCandidate, SkillLookupOptions } from '@deepseek-ai/dsh-skill'
+import { ManagedSkillProvider } from '../src/provider.ts'
+import { MANAGED_SKILL_RANK, type StoredSkill } from '../src/skills.ts'
+
+/** Build a valid stored skill, applying overrides. */
+function skill(overrides: Partial<StoredSkill> = {}): StoredSkill {
+  return {
+    name: 'release-notes',
+    description: 'Write release notes from the merged pull requests.',
+    content: '# Release notes\n',
+    ...overrides,
+  }
+}
+
+/** Build a provider over a fixed registry, capturing warnings. */
+function provider(entries: readonly StoredSkill[]): {
+  readonly subject: ManagedSkillProvider
+  readonly warn: ReturnType<typeof vi.fn>
+} {
+  const warn = vi.fn()
+  const subject = new ManagedSkillProvider({
+    providerName: 'skills-manager',
+    rank: MANAGED_SKILL_RANK,
+    read: () => entries,
+    warn,
+  })
+  return { subject, warn }
+}
+
+/** Lookup options carrying a live signal, the shape the registry passes. */
+function options(): SkillLookupOptions {
+  return { cwd: '/work', signal: new AbortController().signal }
+}
+
+describe('ManagedSkillProvider.list', () => {
+  it('names itself after the configured provider', () => {
+    expect(provider([]).subject.name).toBe('skills-manager')
+  })
+
+  it('maps one candidate per valid entry', async () => {
+    const { subject } = provider([skill(), skill({ name: 'triage-issues', description: 'Triage new issues.' })])
+    const candidates = await subject.list(options())
+    expect(candidates.map(candidate => candidate.name)).toEqual(['release-notes', 'triage-issues'])
+    expect(candidates[0]).toMatchObject({ provider: 'skills-manager', rank: MANAGED_SKILL_RANK, source: 'skills-manager' })
+  })
+
+  it('omits a disabled entry', async () => {
+    const { subject } = provider([skill(), skill({ name: 'parked', enabled: false })])
+    expect((await subject.list(options())).map(candidate => candidate.name)).toEqual(['release-notes'])
+  })
+
+  it('logs and omits an invalid entry instead of failing the catalog', async () => {
+    const { subject, warn } = provider([skill(), skill({ name: 'Bad Name' })])
+    const names = (await subject.list(options())).map(candidate => candidate.name)
+    expect(names).toEqual(['release-notes'])
+    expect(warn).toHaveBeenCalledExactlyOnceWith(
+      expect.stringContaining('skills-manager: ignoring "Bad Name"'),
+    )
+  })
+
+  it('keeps one candidate per name, with the last entry winning', async () => {
+    const { subject } = provider([
+      skill({ description: 'first' }),
+      skill({ description: 'second' }),
+    ])
+    const candidates = await subject.list(options())
+    expect(candidates).toHaveLength(1)
+    expect(candidates[0]!.description).toBe('second')
+  })
+
+  it('observes cancellation before doing any work', async () => {
+    const { subject } = provider([skill()])
+    const controller = new AbortController()
+    controller.abort()
+    await expect(subject.list({ signal: controller.signal })).rejects.toThrow()
+  })
+})
+
+describe('ManagedSkillProvider.get', () => {
+  /** Load one name through the provider, returning the definition. */
+  async function load(subject: ManagedSkillProvider, name: string): Promise<unknown> {
+    const candidate = { name } as unknown as SkillCandidate
+    return await subject.get(candidate, options())
+  }
+
+  it('returns the current body, ranked like the candidate', async () => {
+    const { subject } = provider([skill({ content: '# Body\n' })])
+    await expect(load(subject, 'release-notes')).resolves.toMatchObject({
+      name: 'release-notes',
+      content: '# Body',
+      rank: MANAGED_SKILL_RANK,
+      provider: 'skills-manager',
+    })
+  })
+
+  it('returns undefined for an unknown or disabled skill', async () => {
+    const { subject } = provider([skill({ enabled: false })])
+    await expect(load(subject, 'release-notes')).resolves.toBeUndefined()
+    await expect(load(subject, 'ghost')).resolves.toBeUndefined()
+  })
+
+  it('returns undefined when the entry became invalid after discovery', async () => {
+    const { subject } = provider([skill({ description: '   ' })])
+    await expect(load(subject, 'release-notes')).resolves.toBeUndefined()
+  })
+
+  it('resolves the same duplicate entry that list published', async () => {
+    const { subject } = provider([skill({ content: 'first' }), skill({ content: 'second' })])
+    await expect(load(subject, 'release-notes')).resolves.toMatchObject({ content: 'second' })
+  })
+
+  it('observes cancellation before loading', async () => {
+    const { subject } = provider([skill()])
+    const controller = new AbortController()
+    controller.abort()
+    await expect(subject.get({ name: 'release-notes' } as SkillCandidate, { signal: controller.signal })).rejects.toThrow()
+  })
+})
diff --git a/packages/skill/skills-manager/tests/skill-invocation.spec.ts b/packages/skill/skills-manager/tests/skill-invocation.spec.ts
new file mode 100644
index 0000000000..1c9030f010
--- /dev/null
+++ b/packages/skill/skills-manager/tests/skill-invocation.spec.ts
@@ -0,0 +1,156 @@
+/**
+ * End-to-end proof of the plugin's whole point: a skill registered through the
+ * manager is loaded by the harness's own model-facing `skill` tool.
+ *
+ * Everything on the path is the shipped implementation — the skill registry,
+ * the `tool-skill` consumer that owns the `skill` tool, the tool runtime, and
+ * the agent registry it injects — and the manager is composed beside them
+ * exactly as a profile row composes it. Only the settings provider is an
+ * in-memory stub.
+ */
+
+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { ToolCallId } from '@deepseek-ai/dsh-llm'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime from '@deepseek-ai/dsh-tools'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import SkillRegistry from '@deepseek-ai/dsh-skill'
+import * as toolSkill from '@deepseek-ai/dsh-tool-skill'
+import { SettingsProvider } from '@deepseek-ai/dsh-settings'
+import type { SettingsNamespace } from '@deepseek-ai/dsh-settings'
+import * as manager from '../src/index.ts'
+import type { StoredSkill } from '../src/skills.ts'
+
+/** In-memory settings provider, so the manager persists the registry it is given. */
+class MemorySettings extends SettingsProvider {
+  /** The stored section per namespace. */
+  readonly doc: Record<string, unknown> = {}
+  /** A writable provider records through {@link persist}. */
+  override readonly writable = true
+
+  protected load(): Promise<Record<string, unknown>> {
+    return Promise.resolve(structuredClone(this.doc))
+  }
+
+  protected persist(ns: SettingsNamespace, section: Record<string, unknown>): Promise<void> {
+    this.doc[ns] = structuredClone(section)
+    return Promise.resolve()
+  }
+}
+
+/** Build a valid stored skill, applying overrides. */
+function skill(overrides: Partial<StoredSkill> = {}): StoredSkill {
+  return {
+    name: 'release-notes',
+    description: 'Write release notes from the merged pull requests.',
+    content: '# Release notes\n\n1. Read the git log since the last tag.\n2. Group by area.\n',
+    ...overrides,
+  }
+}
+
+/** Mount the shipped consumer stack beside the manager, as a profile would. */
+async function bench(skills: StoredSkill[]): Promise<Context> {
+  const ctx = new Context()
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(SkillRegistry)
+  await ctx.plugin(MemorySettings)
+  await ctx.plugin(manager, { skills })
+  await ctx.plugin(toolSkill)
+  return ctx
+}
+
+/** Call the harness `skill` tool the way the model loop does. */
+async function load(ctx: Context, name: string) {
+  return await ctx.tools.execute({
+    signal: new AbortController().signal,
+    callId: ToolCallId(`load-${name}`),
+    name: 'skill',
+    arguments: { name },
+  })
+}
+
+/** The rendered text of a tool result, unescaped, as the model would read it. */
+function rendered(result: { content?: readonly unknown[] }): string {
+  return (result.content ?? [])
+    .map(block => (block as { text?: string }).text ?? '')
+    .join('\n')
+}
+
+/** Run one registry-tool call through the manager. */
+async function manage(ctx: Context, name: string, args: unknown) {
+  return await ctx.tools.execute({
+    signal: new AbortController().signal,
+    callId: ToolCallId(`manage-${name}`),
+    name,
+    arguments: args,
+  })
+}
+
+describe('the harness skill tool over the managed registry', () => {
+  it('registers the shipped skill tool beside the management tools', async () => {
+    const ctx = await bench([])
+    expect(ctx.tools.get('skill')).toBeDefined()
+    expect(ctx.tools.get('skills_manager_add')).toBeDefined()
+  })
+
+  it('loads a managed skill, body and all', async () => {
+    const ctx = await bench([skill()])
+
+    const result = await load(ctx, 'release-notes')
+
+    expect(result.isError).toBe(false)
+    const text = rendered(result)
+    expect(text).toContain('<skill_content name="release-notes">')
+    expect(text).toContain('<skill_instructions>')
+    expect(text).toContain('Read the git log since the last tag.')
+    expect(text).toContain('Group by area.')
+  })
+
+  it('loads a skill added at runtime, with no reload', async () => {
+    const ctx = await bench([])
+
+    const added = await manage(ctx, 'skills_manager_add', {
+      name: 'triage-issues',
+      description: 'Triage the incoming issue queue.',
+      content: 'Label every new issue within one day.',
+    })
+    expect(added.isError).toBe(false)
+
+    const result = await load(ctx, 'triage-issues')
+    expect(result.isError).toBe(false)
+    expect(rendered(result)).toContain('Label every new issue within one day.')
+  })
+
+  it('stops loading a skill the manager removed', async () => {
+    const ctx = await bench([skill()])
+    expect((await load(ctx, 'release-notes')).isError).toBe(false)
+
+    await manage(ctx, 'skills_manager_remove', { name: 'release-notes' })
+
+    const after = await load(ctx, 'release-notes')
+    expect(after.isError).toBe(true)
+    expect(rendered(after)).toContain('unknown or no longer available')
+  })
+
+  it('refuses to load a disabled skill', async () => {
+    const ctx = await bench([skill()])
+
+    await manage(ctx, 'skills_manager_set_enabled', { name: 'release-notes', enabled: false })
+
+    const result = await load(ctx, 'release-notes')
+    expect(result.isError).toBe(true)
+    expect(rendered(result)).toContain('unknown or no longer available')
+  })
+
+  it('keeps a model-hidden skill out of the tool even though the body exists', async () => {
+    const ctx = await bench([skill({ disableModelInvocation: true })])
+
+    const result = await load(ctx, 'release-notes')
+
+    expect(result.isError).toBe(true)
+    expect(rendered(result)).toContain('not available for model invocation')
+  })
+})
diff --git a/packages/skill/skills-manager/tests/skills.spec.ts b/packages/skill/skills-manager/tests/skills.spec.ts
new file mode 100644
index 0000000000..c229b94e5f
--- /dev/null
+++ b/packages/skill/skills-manager/tests/skills.spec.ts
@@ -0,0 +1,151 @@
+/** Tests for the pure skill registry: validation, invocation policy, and projection. */
+
+import { describe, expect, it } from 'vitest'
+import {
+  DEFAULT_PROVIDER_NAME,
+  MANAGED_SKILL_RANK,
+  MANAGED_SKILL_SOURCE,
+  MAX_CONTENT_LENGTH,
+  MAX_DESCRIPTION_LENGTH,
+  MAX_SKILL_NAME_LENGTH,
+  MAX_WHEN_TO_USE_LENGTH,
+  SETTINGS_NS,
+  invocationOf,
+  toCandidate,
+  toDefinition,
+  validateStoredSkill,
+  type StoredSkill,
+} from '../src/skills.ts'
+
+/** Build a valid stored skill, applying overrides. */
+function skill(overrides: Partial<StoredSkill> = {}): StoredSkill {
+  return {
+    name: 'release-notes',
+    description: 'Write release notes from the merged pull requests.',
+    content: '# Release notes\n\n1. Read the git log.\n',
+    ...overrides,
+  }
+}
+
+/** The provider identity the projection tests stamp on every result. */
+const OPTIONS = { providerName: DEFAULT_PROVIDER_NAME, rank: MANAGED_SKILL_RANK }
+
+describe('registry constants', () => {
+  it('owns one settings namespace and one provider identity', () => {
+    expect(SETTINGS_NS).toBe('skills-manager')
+    expect(DEFAULT_PROVIDER_NAME).toBe('skills-manager')
+    expect(MANAGED_SKILL_SOURCE).toBe('skills-manager')
+  })
+
+  it('ranks managed skills between the custom root (300) and the user DSH root (400)', () => {
+    expect(MANAGED_SKILL_RANK).toBe(350)
+  })
+})
+
+describe('validateStoredSkill', () => {
+  it('accepts a complete entry', () => {
+    expect(validateStoredSkill(skill())).toEqual([])
+  })
+
+  it('accepts an entry whose optional fields are absent', () => {
+    // The settings document stays lossless-JSON, so an omitted optional field
+    // is absent rather than present-and-undefined.
+    const sparse = JSON.parse(JSON.stringify(skill())) as StoredSkill
+    delete sparse.whenToUse
+    delete sparse.disableModelInvocation
+    delete sparse.userInvocable
+    delete sparse.enabled
+    expect(validateStoredSkill(sparse)).toEqual([])
+  })
+
+  it('rejects a name outside the kebab-case grammar', () => {
+    expect(validateStoredSkill(skill({ name: 'Release Notes' }))).toEqual([
+      '"Release Notes" is not a kebab-case skill name (lowercase letters, digits, and single hyphens)',
+    ])
+    expect(validateStoredSkill(skill({ name: 'release_notes' }))).toHaveLength(1)
+    expect(validateStoredSkill(skill({ name: '-release' }))).toHaveLength(1)
+  })
+
+  it('rejects a name longer than the schema bound', () => {
+    expect(validateStoredSkill(skill({ name: 'a'.repeat(MAX_SKILL_NAME_LENGTH + 1) }))).toEqual([
+      `the name is longer than ${String(MAX_SKILL_NAME_LENGTH)} characters`,
+    ])
+  })
+
+  it('rejects an empty or oversized description', () => {
+    expect(validateStoredSkill(skill({ description: '   ' }))).toEqual(['the description is empty'])
+    expect(validateStoredSkill(skill({ description: 'x'.repeat(MAX_DESCRIPTION_LENGTH + 1) }))).toEqual([
+      `the description is longer than ${String(MAX_DESCRIPTION_LENGTH)} characters`,
+    ])
+  })
+
+  it('rejects an oversized when-to-use note', () => {
+    expect(validateStoredSkill(skill({ whenToUse: 'x'.repeat(MAX_WHEN_TO_USE_LENGTH + 1) }))).toEqual([
+      `the "when to use" note is longer than ${String(MAX_WHEN_TO_USE_LENGTH)} characters`,
+    ])
+  })
+
+  it('rejects empty or oversized instructions', () => {
+    expect(validateStoredSkill(skill({ content: '\n \t' }))).toEqual(['the instructions are empty'])
+    expect(validateStoredSkill(skill({ content: 'x'.repeat(MAX_CONTENT_LENGTH + 1) }))).toEqual([
+      `the instructions are longer than ${String(MAX_CONTENT_LENGTH)} characters`,
+    ])
+  })
+
+  it('reports every independent problem at once', () => {
+    expect(validateStoredSkill({ name: 'Bad Name', description: '', content: '' })).toEqual([
+      '"Bad Name" is not a kebab-case skill name (lowercase letters, digits, and single hyphens)',
+      'the description is empty',
+      'the instructions are empty',
+    ])
+  })
+})
+
+describe('invocationOf', () => {
+  it('permits both audiences when neither flag is set', () => {
+    expect(invocationOf(skill())).toEqual({ modelInvocable: true, userInvocable: true })
+  })
+
+  it('honours the disable-model-invocation flag', () => {
+    expect(invocationOf(skill({ disableModelInvocation: true })).modelInvocable).toBe(false)
+    expect(invocationOf(skill({ disableModelInvocation: false })).modelInvocable).toBe(true)
+  })
+
+  it('honours the user-invocable flag', () => {
+    expect(invocationOf(skill({ userInvocable: false })).userInvocable).toBe(false)
+    expect(invocationOf(skill({ userInvocable: true })).userInvocable).toBe(true)
+  })
+})
+
+describe('toCandidate', () => {
+  it('stamps the provider identity, rank, and source', () => {
+    const candidate = toCandidate(skill(), OPTIONS)
+    expect(candidate).toMatchObject({
+      name: 'release-notes',
+      provider: DEFAULT_PROVIDER_NAME,
+      rank: MANAGED_SKILL_RANK,
+      source: MANAGED_SKILL_SOURCE,
+      locator: 'release-notes',
+      invocation: { modelInvocable: true, userInvocable: true },
+    })
+  })
+
+  it('omits whenToUse entirely when it is absent or blank', () => {
+    expect(toCandidate(skill(), OPTIONS)).not.toHaveProperty('whenToUse')
+    expect(toCandidate(skill({ whenToUse: '   ' }), OPTIONS)).not.toHaveProperty('whenToUse')
+  })
+
+  it('trims the description and the when-to-use note', () => {
+    const candidate = toCandidate(skill({ description: '  trimmed  ', whenToUse: '  on demand  ' }), OPTIONS)
+    expect(candidate.description).toBe('trimmed')
+    expect(candidate.whenToUse).toBe('on demand')
+  })
+})
+
+describe('toDefinition', () => {
+  it('carries the trimmed body', () => {
+    const definition = toDefinition(skill({ content: '\n  # Body  \n' }), OPTIONS)
+    expect(definition.content).toBe('# Body')
+    expect(definition.name).toBe('release-notes')
+  })
+})
diff --git a/packages/skill/skills-manager/tests/styles.client.spec.ts b/packages/skill/skills-manager/tests/styles.client.spec.ts
new file mode 100644
index 0000000000..d78d1800ce
--- /dev/null
+++ b/packages/skill/skills-manager/tests/styles.client.spec.ts
@@ -0,0 +1,59 @@
+/**
+ * Skills manager card stylesheet contract, asserted against the CSS text on disk.
+ *
+ * A `--dsw-*` name the theme does not declare fails silently: the browser takes
+ * the `var()` fallback, so the card still renders and only one control is
+ * wrong. Checking every name against the sheets that declare them turns that
+ * failure into a test failure.
+ */
+import { readdirSync, readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { describe, expect, it } from 'vitest'
+
+const css = readFileSync(
+  fileURLToPath(new URL('../src/client/SkillsManagerCard.module.css', import.meta.url)),
+  'utf8',
+)
+// Every theme sheet, not just the platform tokens: sibling sheets declare the
+// font and scrollbar variables, and a gate reading one file would call those
+// names undeclared.
+const tokens = readdirSync(fileURLToPath(new URL('../../../client/ui-theme/src/styles/', import.meta.url)))
+  .filter(name => name.endsWith('.css'))
+  .map(name => readFileSync(
+    fileURLToPath(new URL(`../../../client/ui-theme/src/styles/${name}`, import.meta.url)),
+    'utf8',
+  ))
+  .join('\n')
+
+/** The declarations of one top-level rule, by selector. */
+function block(selector: string): string {
+  const match = new RegExp(`^\\${selector} \\{([^}]*)\\}`, 'm').exec(css)
+  if (match === null) throw new Error(`SkillsManagerCard.module.css has no \`${selector}\` rule`)
+  return match[1] ?? ''
+}
+
+describe('SkillsManagerCard theme styles', () => {
+  it('names only theme variables the token sheet defines', () => {
+    const named = [...css.matchAll(/var\((--(?:dsw|dsh|ds)-[a-z0-9-]+)/g)].map(match => match[1])
+    const undeclared = [...new Set(named)].filter(name => !tokens.includes(`  ${String(name)}:`))
+    expect(undeclared).toEqual([])
+  })
+
+  it('closes every block, so no rule is swallowed by the one above it', () => {
+    const bare = css.replace(/\/\*[\s\S]*?\*\//g, '')
+    expect((bare.match(/\}/g) ?? []).length).toBe((bare.match(/\{/g) ?? []).length)
+  })
+
+  it('paints the primary action with the shared button pair', () => {
+    // The card owns its own class names, so nothing else fails when its
+    // primary action is invisible; the pair is the contract.
+    expect(block('.primary')).toContain('background: var(--dsw-alias-button-primary-fill)')
+    expect(block('.primary')).toContain('color: var(--dsw-alias-label-primary-foreground)')
+  })
+
+  it('never falls back to a literal colour', () => {
+    // A declared token never takes its fallback, so a literal here is a single
+    // colour for both themes and hides the next undeclared name.
+    expect(css).not.toMatch(/var\(--dsw-[a-z0-9-]+\s*,\s*(?:#|rgb|rgba|hsl|hsla)/)
+  })
+})
diff --git a/packages/skill/skills-manager/tests/tools.spec.ts b/packages/skill/skills-manager/tests/tools.spec.ts
new file mode 100644
index 0000000000..55ca4c527b
--- /dev/null
+++ b/packages/skill/skills-manager/tests/tools.spec.ts
@@ -0,0 +1,172 @@
+/** Tests for the model-facing management tools against a stub registry port. */
+
+import { describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { type ToolExecutionInput } from '@deepseek-ai/dsh-tools'
+import { managerTools, statusOf, type SkillsPort } from '../src/tools.ts'
+import type { StoredSkill } from '../src/skills.ts'
+
+/** Build a valid stored skill, applying overrides. */
+function skill(overrides: Partial<StoredSkill> = {}): StoredSkill {
+  return {
+    name: 'release-notes',
+    description: 'Write release notes from the merged pull requests.',
+    content: '# Release notes\n',
+    ...overrides,
+  }
+}
+
+/** One registry-tool call, with the branded call id the registry expects. */
+function call(name: string, args: unknown): ToolExecutionInput {
+  return {
+    callId: `call-${name}` as ToolExecutionInput['callId'],
+    name,
+    arguments: args,
+    signal: new AbortController().signal,
+  }
+}
+
+interface Bench {
+  readonly ctx: Context
+  readonly calls: string[]
+  readonly current: () => readonly StoredSkill[]
+}
+
+/** Mount the four management tools over an in-memory registry port. */
+async function bench(initial: readonly StoredSkill[] = []): Promise<Bench> {
+  const ctx = new Context()
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  const calls: string[] = []
+  let entries: StoredSkill[] = [...initial]
+  const port: SkillsPort = {
+    list: () => entries.map(statusOf),
+    upsert: async (entry) => {
+      calls.push(`upsert:${entry.name}`)
+      entries = [...entries.filter(candidate => candidate.name !== entry.name), entry]
+    },
+    remove: async (name) => {
+      calls.push(`remove:${name}`)
+      entries = entries.filter(candidate => candidate.name !== name)
+    },
+    setEnabled: async (name, enabled) => {
+      calls.push(`setEnabled:${name}:${String(enabled)}`)
+      entries = entries.map(candidate => candidate.name === name ? { ...candidate, enabled } : candidate)
+    },
+  }
+  for (const tool of managerTools(port)) ctx.tools.register(tool)
+  return { ctx, calls, current: () => entries }
+}
+
+describe('skills_manager_list', () => {
+  it('returns the status table for the whole registry', async () => {
+    const { ctx } = await bench([skill(), skill({ name: 'parked', enabled: false })])
+    const result = await ctx.tools.execute(call('skills_manager_list', {}))
+    expect(result.isError).toBe(false)
+    expect(result.value).toEqual({
+      skills: [
+        {
+          name: 'release-notes',
+          description: 'Write release notes from the merged pull requests.',
+          enabled: true,
+          modelInvocable: true,
+          userInvocable: true,
+          characters: 16,
+          problems: [],
+        },
+        {
+          name: 'parked',
+          description: 'Write release notes from the merged pull requests.',
+          enabled: false,
+          modelInvocable: true,
+          userInvocable: true,
+          characters: 16,
+          problems: [],
+        },
+      ],
+    })
+  })
+})
+
+describe('skills_manager_add', () => {
+  it('upserts the entry the arguments describe and returns the fresh table', async () => {
+    const { ctx, calls } = await bench()
+    const result = await ctx.tools.execute(call('skills_manager_add', {
+      name: 'triage-issues',
+      description: 'Triage new issues.',
+      content: 'Read the queue.',
+      whenToUse: 'When a new issue arrives.',
+      disableModelInvocation: true,
+      userInvocable: false,
+      enabled: true,
+    }))
+    expect(result.isError).toBe(false)
+    expect(calls).toEqual(['upsert:triage-issues'])
+    expect((result.value as { skills: { name: string; modelInvocable: boolean; userInvocable: boolean }[] }).skills[0])
+      .toMatchObject({ name: 'triage-issues', modelInvocable: false, userInvocable: false })
+  })
+
+  it('omits unset optional fields rather than storing blanks', async () => {
+    const { ctx, current } = await bench()
+    await ctx.tools.execute(call('skills_manager_add', {
+      name: 'triage-issues',
+      description: 'Triage new issues.',
+      content: 'Read the queue.',
+      whenToUse: '   ',
+    }))
+    expect(current()[0]).toEqual({
+      name: 'triage-issues',
+      description: 'Triage new issues.',
+      content: 'Read the queue.',
+    })
+  })
+
+  it('rejects an invalid entry through the port', async () => {
+    const ctx = new Context()
+    await ctx.plugin(SystemPrompt)
+    await ctx.plugin(ToolRuntime)
+    const upsert = vi.fn(() => Promise.reject(new Error('invalid skill "Bad Name": bad')))
+    const port: SkillsPort = { list: () => [], upsert, remove: () => Promise.resolve(), setEnabled: () => Promise.resolve() }
+    for (const tool of managerTools(port)) ctx.tools.register(tool)
+    const result = await ctx.tools.execute(call('skills_manager_add', { name: 'Bad Name', description: 'x', content: 'y' }))
+    expect(result.isError).toBe(true)
+    expect(upsert).toHaveBeenCalledOnce()
+  })
+})
+
+describe('skills_manager_remove', () => {
+  it('removes one entry by name', async () => {
+    const { ctx, calls, current } = await bench([skill()])
+    const result = await ctx.tools.execute(call('skills_manager_remove', { name: 'release-notes' }))
+    expect(result.isError).toBe(false)
+    expect(calls).toEqual(['remove:release-notes'])
+    expect(current()).toEqual([])
+  })
+})
+
+describe('skills_manager_set_enabled', () => {
+  it('flips one entry without touching its body', async () => {
+    const { ctx, calls, current } = await bench([skill()])
+    const result = await ctx.tools.execute(call('skills_manager_set_enabled', { name: 'release-notes', enabled: false }))
+    expect(result.isError).toBe(false)
+    expect(calls).toEqual(['setEnabled:release-notes:false'])
+    expect(current()[0]).toMatchObject({ name: 'release-notes', enabled: false, content: '# Release notes\n' })
+  })
+})
+
+describe('statusOf', () => {
+  it('reports the invocation policy, size, and problems', () => {
+    expect(statusOf(skill({ disableModelInvocation: true, whenToUse: ' on demand ' }))).toEqual({
+      name: 'release-notes',
+      description: 'Write release notes from the merged pull requests.',
+      whenToUse: 'on demand',
+      enabled: true,
+      modelInvocable: false,
+      userInvocable: true,
+      characters: 16,
+      problems: [],
+    })
+    expect(statusOf(skill({ content: '' })).problems).toEqual(['the instructions are empty'])
+  })
+})
