--- /dev/null
+++ b/packages/mcp/mcp-manager/tests/card-controller.client.spec.ts
@@ -0,0 +1,458 @@
+/**
+ * Card controller unit tests: the pure bridge between the `mcp-manager`
+ * settings scope and the card's form model. A fake scope stands in for the
+ * browser transport, so draft parsing, validation, and every gesture are
+ * exercised without a DOM or a Host.
+ */
+
+import { describe, expect, it, vi } from 'vitest'
+import type { SettingsScope, SettingsScopeSnapshot } from '@deepseek-ai/dsh-client-ui-settings/client'
+import {
+  MCP_MANAGER_PAGE_SIZE,
+  McpManagerCardController,
+  type McpManagerCardFace,
+  type McpManagerSettings,
+} from '../src/client/card-controller.ts'
+import { en, zh } from '../src/client/locales.ts'
+
+/** One `servers` write captured from {@link FakeScope.set}. */
+interface WriteCall {
+  readonly field: string
+  readonly value: unknown
+}
+
+/** A controllable SettingsScope face for one namespace. */
+class FakeScope {
+  status: SettingsScopeSnapshot<McpManagerSettings>['status'] = 'ready'
+  value: McpManagerSettings | undefined
+  writable = true
+  /** When set, `set` rejects with this error. */
+  failWith: Error | undefined
+  readonly calls: WriteCall[] = []
+  private readonly listeners = new Set<() => void>()
+
+  constructor(value?: McpManagerSettings) {
+    this.value = value
+  }
+
+  getSnapshot(): SettingsScopeSnapshot<McpManagerSettings> {
+    return {
+      status: this.status,
+      value: this.value,
+      base: undefined,
+      user: undefined,
+      revision: 1,
+      writable: this.writable,
+      mode: 'host',
+    }
+  }
+
+  subscribe(listener: () => void): () => void {
+    this.listeners.add(listener)
+    return () => { this.listeners.delete(listener) }
+  }
+
+  mutate(): Promise<void> {
+    return Promise.resolve()
+  }
+
+  set(field: string, value: unknown): Promise<void> {
+    this.calls.push({ field, value })
+    return this.failWith === undefined ? Promise.resolve() : Promise.reject(this.failWith)
+  }
+
+  unset(): Promise<void> {
+    return Promise.resolve()
+  }
+
+  /** Republish the current value, as a Host update would. */
+  emit(): void {
+    for (const listener of [...this.listeners]) listener()
+  }
+
+  /** This fake viewed through the interface the controller consumes. */
+  asScope(): SettingsScope<McpManagerSettings> {
+    return this
+  }
+}
+
+/** Mount a controller over a fake scope and hand back both. */
+function mounted(value?: McpManagerSettings): {
+  scope: FakeScope
+  controller: McpManagerCardController
+  face: McpManagerCardFace
+} {
+  const scope = new FakeScope(value)
+  const controller = new McpManagerCardController(scope.asScope())
+  return { scope, controller, face: controller.inject() }
+}
+
+/** The face's snapshot, read through the injected store. */
+function state(face: McpManagerCardFace): ReturnType<McpManagerCardFace['hooks']['mcpManagerCard']['getSnapshot']> {
+  return face.hooks.mcpManagerCard.getSnapshot()
+}
+
+/** The single `servers` array the last write carried. */
+function lastServers(scope: FakeScope): unknown {
+  const call = scope.calls.at(-1)
+  expect(call?.field).toBe('servers')
+  return call?.value
+}
+
+describe('card dictionaries', () => {
+  it('keeps both locales on the same key set', () => {
+    expect(Object.keys(en).sort()).toEqual(Object.keys(zh).sort())
+  })
+})
+
+describe('McpManagerCardController projection', () => {
+  it('projects the scope value into server views', () => {
+    const { face } = mounted({
+      servers: [
+        { name: 'files', transport: 'stdio', command: 'npx', args: ['-y', 'server-filesystem'] },
+        { name: 'web', transport: 'streamable-http', url: 'https://example.test/mcp', enabled: false },
+      ],
+    })
+
+    const snapshot = state(face)
+    expect(snapshot.available).toBe(true)
+    expect(snapshot.writable).toBe(true)
+    expect(snapshot.servers).toEqual([
+      { name: 'files', transport: 'stdio', enabled: true, target: 'npx -y server-filesystem' },
+      { name: 'web', transport: 'streamable-http', enabled: false, target: 'https://example.test/mcp' },
+    ])
+  })
+
+  it('renders an empty target for an entry that omits its transport fields', () => {
+    const { face } = mounted({
+      servers: [
+        { name: 'bare-stdio', transport: 'stdio' },
+        { name: 'bare-http', transport: 'streamable-http' },
+      ],
+    })
+
+    expect(state(face).servers.map(server => server.target)).toEqual(['', ''])
+  })
+
+  it('reprojects when the scope republishes', () => {
+    const { scope, face } = mounted({ servers: [] })
+    expect(state(face).servers).toEqual([])
+
+    scope.value = { servers: [{ name: 'late', transport: 'stdio', command: 'node' }] }
+    scope.emit()
+    expect(state(face).servers).toEqual([{ name: 'late', transport: 'stdio', enabled: true, target: 'node' }])
+  })
+
+  it('marks the card unavailable until the namespace resolves', () => {
+    const { scope, face } = mounted()
+    scope.status = 'unavailable'
+    scope.emit()
+
+    expect(state(face).available).toBe(false)
+    face.add()
+    expect(scope.calls).toEqual([])
+  })
+
+  it('stops projecting after dispose', () => {
+    const { scope, controller, face } = mounted({ servers: [] })
+    controller.dispose()
+
+    scope.value = { servers: [{ name: 'after', transport: 'stdio', command: 'node' }] }
+    scope.emit()
+    expect(state(face).servers).toEqual([])
+  })
+})
+
+describe('McpManagerCardController drafts', () => {
+  it('stages field text, transport, and reset', () => {
+    const { face } = mounted({ servers: [] })
+
+    face.edit('name', 'my-server')
+    face.edit('args', 'one\ntwo')
+    expect(state(face).draft.name).toBe('my-server')
+    expect(state(face).draft.args).toBe('one\ntwo')
+
+    face.setTransport('streamable-http')
+    expect(state(face).draft.transport).toBe('streamable-http')
+
+    face.resetDraft()
+    expect(state(face).draft).toMatchObject({ name: '', transport: 'stdio', args: '' })
+  })
+
+  it('writes a parsed stdio server and clears the form', async () => {
+    const { scope, face } = mounted({ servers: [] })
