+/**
+ * Integration tests for the MCP manager's mount loop: a configured registry
+ * mounts one child `dsh-mcp-client` per enabled entry, so each server's MCP
+ * tools land in the harness ToolRuntime, and the management tools add, remove,
+ * and disable servers at runtime.
+ *
+ * The child plugin is mocked at the package boundary (`@deepseek-ai/dsh-mcp-client`)
+ * rather than at the MCP SDK boundary: `mcp-client` resolves its SDK copy
+ * through its own pnpm node_modules, which a mock declared from this package
+ * cannot intercept. The stub still registers real ToolRuntime tools and is
+ * effect-scoped, so the manager's reconcile/mount/dispose contract is exercised
+ * end-to-end. The real protocol bridge is covered by
+ * `packages/mcp/mcp-client/tests/mcp-client.e2e.ts` and
+ * `packages/mcp/mcp-manager/tests/manager.e2e.ts`.
+ */
+
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { defineTool, type ToolExecutionInput } from '@deepseek-ai/dsh-tools'
+import { SettingsProvider } from '@deepseek-ai/dsh-settings'
+import type { SettingsNamespace } from '@deepseek-ai/dsh-settings'
+import { DEFAULT_TOOL_CALL_TIMEOUT_MS, type McpServerEntry } from '../src/servers.ts'
+
+/** In-memory settings provider: the manager's persisted registry, for tests. */
+class MemorySettings extends SettingsProvider {
+  /** The stored section per namespace. */
+  readonly doc: Record<string, unknown> = {}
+  /** A writable provider records through {@link persist}. */
+  override readonly writable = true
+  /** Reject the next write, to exercise the rollback path. */
+  rejectNext = false
+
+  protected load(): Promise<Record<string, unknown>> {
+    return Promise.resolve(structuredClone(this.doc))
+  }
+
+  protected persist(ns: SettingsNamespace, section: Record<string, unknown>): Promise<void> {
+    if (this.rejectNext) {
+      this.rejectNext = false
+      return Promise.reject(new Error('settings write refused'))
+    }
+    this.doc[ns] = structuredClone(section)
+    return Promise.resolve()
+  }
+}
+
+/** One child-mount call the manager issued, captured for assertions. */
+interface MountCall {
+  readonly serverName: string
+  readonly transport: string
+  readonly target: string
+}
+
+/** The projected config the stub child receives, narrowed for assertions. */
+interface StubClientConfig {
+  readonly serverName: string
+  readonly transport?: string
+  readonly command?: string
+  readonly url?: string
+}
+
+const { mockApply, mounts, flags } = vi.hoisted(() => ({
+  mockApply: vi.fn<(ctx: unknown, config: StubClientConfig) => Promise<void>>(),
+  mounts: [] as MountCall[],
+  flags: { throwOnDispose: false },
+}))
+
+// The stub module namespace is what `ctx.plugin(McpClient, config)` receives.
+// `apply` defers to the hoisted mock so each test owns the implementation.
+vi.mock('@deepseek-ai/dsh-mcp-client', () => ({
+  name: 'mcp-client',
+  inject: ['tools'],
+  // Cordis normalizes the child config through the plugin `Config` Standard
+  // Schema; this permissive one keeps the projected config observable below.
+  Config: {
+    '~standard': {
+      version: 1,
+      vendor: 'mcp-manager-test',
+      validate: (value: unknown) => ({ value }),
+    },
+  },
+  apply: (ctx: unknown, config: unknown) => mockApply(ctx, config as StubClientConfig),
+}))
+
+/**
+ * Mount the tool registry every manager instance injects. The registry injects
+ * `systemPrompt`, so that service is mounted first, as a real composition does.
+ */
+async function mountTools(): Promise<Context> {
+  const ctx = new Context()
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  return ctx
+}
+
+/** One valid stdio registry entry. */
+function stdioEntry(name: string): McpServerEntry {
+  return {
+    name,
+    transport: 'stdio',
+    enabled: true,
+    command: 'echo',
+    args: [],
+    env: {},
+    cwd: '',
+    url: '',
+    headers: {},
+    toolCallTimeoutMs: DEFAULT_TOOL_CALL_TIMEOUT_MS,
+  }
+}
+
+/** One registry-tool call, with the branded call id the registry expects. */
+function call(name: string, args: unknown): ToolExecutionInput {
+  return {
+    callId: `call-${name}` as ToolExecutionInput['callId'],
+    name,
+    arguments: args,
+    signal: new AbortController().signal,
+  }
+}
+
+/** Register one `mcp__<name>__add` tool on the plugin context, effect-scoped. */
+function registerStubTool(ctx: Context, serverName: string): void {
+  ctx.effect(() => {
+    const dispose = ctx.tools.register(defineTool({
+      name: `mcp__${serverName}__add`,
+      description: `Adds two numbers via ${serverName}.`,
+      parameters: { a: { type: 'number', required: true }, b: { type: 'number', required: true } },
+      output: { schema: { type: 'number' }, render: (_args, value) => [{ type: 'text', text: String(value) }] },
+      async execute(args): Promise<number> {
+        return args.a + args.b
+      },
+    }))
+    return () => {
+      dispose()
+      if (flags.throwOnDispose) throw new Error('dispose failed')
+    }
+  }, 'stub-mcp-client.tool')
+}
+
+describe('mcp-manager integration', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    mounts.length = 0
+    flags.throwOnDispose = false
+    mockApply.mockImplementation(async (rawCtx, config) => {
+      const ctx = rawCtx as Context
+      mounts.push({
+        serverName: config.serverName,
+        transport: config.transport ?? '',
+        target: config.command ?? config.url ?? '',
+      })
+      registerStubTool(ctx, config.serverName)
+    })
+  })
+
+  it('mounts a configured server so its MCP tools become native harness tools', async () => {
+    const ctx = await mountTools()
+    const fiber = ctx.plugin(
+      (await import('../src/index.ts')),
+      { servers: [stdioEntry('fixture')] },
+    )
+    await fiber.await()
+
+    await vi.waitFor(() => { expect(ctx.tools.get('mcp__fixture__add')).toBeDefined() }, { timeout: 5_000 })
+    expect(ctx.tools.get('mcp__fixture__add')?.description).toBe('Adds two numbers via fixture.')
+    // The child was mounted with the projected stdio config.
+    expect(mounts).toEqual([{ serverName: 'fixture', transport: 'stdio', target: 'echo' }])
+    // The management tools share the same registry.
+    expect(ctx.tools.get('mcp_manager_list')).toBeDefined()
+    expect(ctx.tools.get('mcp_manager_add')).toBeDefined()
+    expect(ctx.tools.get('mcp_manager_remove')).toBeDefined()
+    expect(ctx.tools.get('mcp_manager_set_enabled')).toBeDefined()
+
+    await fiber.dispose()
+    expect(ctx.tools.get('mcp__fixture__add')).toBeUndefined()
+  })
+
+  it('adds and removes a server at runtime through the management tools', async () => {
+    const ctx = await mountTools()
+    const fiber = ctx.plugin((await import('../src/index.ts')), { servers: [] })
+    await fiber.await()
+    expect(ctx.tools.get('mcp__late__add')).toBeUndefined()
+
+    await ctx.tools.execute(call('mcp_manager_add', {
+      name: 'late',
+      transport: 'stdio',
+      command: 'echo',
+    }))
+    await vi.waitFor(() => { expect(ctx.tools.get('mcp__late__add')).toBeDefined() }, { timeout: 5_000 })
+
+    await ctx.tools.execute(call('mcp_manager_remove', { name: 'late' }))
+    await vi.waitFor(() => { expect(ctx.tools.get('mcp__late__add')).toBeUndefined() }, { timeout: 5_000 })
+
+    await fiber.dispose()
+  })
+
+  it('executes a mounted MCP tool through the harness registry', async () => {
+    const ctx = await mountTools()
+    const fiber = ctx.plugin((await import('../src/index.ts')), { servers: [stdioEntry('math')] })
+    await fiber.await()
+    await vi.waitFor(() => { expect(ctx.tools.get('mcp__math__add')).toBeDefined() }, { timeout: 5_000 })
+
+    const result = await ctx.tools.execute(call('mcp__math__add', { a: 2, b: 3 }))
+    expect(result.value).toBe(5)
+
+    await fiber.dispose()
+  })
+
+  it('does not mount a disabled server', async () => {
+    const ctx = await mountTools()
+    const fiber = ctx.plugin((await import('../src/index.ts')), { servers: [{ ...stdioEntry('off'), enabled: false }] })
+    await fiber.await()
+
+    expect(ctx.tools.get('mcp__off__add')).toBeUndefined()
+    expect(mounts).toEqual([])
+    await fiber.dispose()
+  })
+
+  it('reports each server through the mcp_manager_list tool', async () => {
+    const ctx = await mountTools()
+    const fiber = ctx.plugin((await import('../src/index.ts')), { servers: [stdioEntry('math')] })
+    await fiber.await()
+
+    // The tool registers a tick before the reconcile loop records the mount,
+    // so poll the reported status rather than sampling it once.
+    await vi.waitFor(async () => {
+      const result = await ctx.tools.execute(call('mcp_manager_list', {}))
+      expect(result.isError).toBe(false)
+      expect((result.value as { servers: unknown[] }).servers).toEqual([
+        { name: 'math', transport: 'stdio', enabled: true, connected: true, target: 'echo', tools: ['add'], problems: [] },
+      ])
+    }, { timeout: 5_000 })
+
+    await fiber.dispose()
+  })
+
+  it('contains a failed child mount and keeps the entry configured', async () => {
+    const ctx = await mountTools()
+    const fiber = ctx.plugin((await import('../src/index.ts')), { servers: [] })
+    await fiber.await()
+
+    mockApply.mockImplementationOnce(async (_rawCtx, config) => {
+      mounts.push({ serverName: config.serverName, transport: config.transport ?? '', target: config.command ?? config.url ?? '' })
+      throw new Error('spawn failed')
+    })
+    const added = await ctx.tools.execute(call('mcp_manager_add', { name: 'boom', transport: 'stdio', command: 'echo' }))
+    expect(added.isError).toBe(false)
+    await vi.waitFor(() => { expect(mounts).toHaveLength(1) }, { timeout: 5_000 })
+    expect(ctx.tools.get('mcp__boom__add')).toBeUndefined()
+
+    const listed = await ctx.tools.execute(call('mcp_manager_list', {}))
+    const value = listed.value as { servers: { name: string; connected: boolean }[] }
+    expect(value.servers.map(server => [server.name, server.connected])).toEqual([['boom', false]])
+
+    await fiber.dispose()
+  })
+
+  it('rejects an invalid entry without changing the registry', async () => {
+    const ctx = await mountTools()
+    const fiber = ctx.plugin((await import('../src/index.ts')), { servers: [] })
+    await fiber.await()
+
+    const result = await ctx.tools.execute(call('mcp_manager_add', { name: 'bad name!', transport: 'stdio', command: 'echo' }))
+    expect(result.isError).toBe(true)
+
+    const listed = await ctx.tools.execute(call('mcp_manager_list', {}))
+    expect((listed.value as { servers: unknown[] }).servers).toEqual([])
+
+    await fiber.dispose()
+  })
+
+  it('treats remove and set-enabled for absent or unchanged entries as no-ops', async () => {
+    const ctx = await mountTools()
+    const fiber = ctx.plugin((await import('../src/index.ts')), { servers: [stdioEntry('keep')] })
+    await fiber.await()
+    await vi.waitFor(() => { expect(ctx.tools.get('mcp__keep__add')).toBeDefined() }, { timeout: 5_000 })
+
+    expect((await ctx.tools.execute(call('mcp_manager_remove', { name: 'ghost' }))).isError).toBe(false)
+    expect((await ctx.tools.execute(call('mcp_manager_set_enabled', { name: 'keep', enabled: true }))).isError).toBe(false)
+    expect(ctx.tools.get('mcp__keep__add')).toBeDefined()
+
+    await fiber.dispose()
+  })
+
+  it('persists edits through the settings section and reconciles on external change', async () => {
+    const ctx = await mountTools()
