+    expect(snapshot.writable).toBe(true)
+    expect(snapshot.skills.map(entry => entry.name)).toEqual(['sample', 'other'])
+    expect(snapshot.matched).toBe(2)
+    expect(snapshot.visible).toHaveLength(2)
+  })
+
+  it('reprojects when the scope republishes', () => {
