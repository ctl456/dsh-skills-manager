+    expect(state(face).skills).toEqual([])
+
+    scope.value = { skills: [skill({ name: 'late' })] }
+    scope.emit()
+    expect(state(face).skills.map(entry => entry.name)).toEqual(['late'])
+  })
+
+  it('marks the card unavailable until the namespace resolves', () => {
+    const { scope, face } = mounted()
+    scope.status = 'unavailable'
+    scope.emit()
+
+    expect(state(face).available).toBe(false)
+    face.openAdd()
